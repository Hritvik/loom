#!/usr/bin/env python3
"""One command for the loom coordination engine.

The engine verbs are the CLI: `loom claim`, `loom transition`, `loom events`, and the rest. This
file routes those to `engine.py` in-process, and adds the unattended verbs that the engine does not
need to know about: `tick`, `workers`, `schedule`, `linear` and `logs`.

    loom claim <id> --revision N --epoch E --agent <you>
    loom tick [--apply] [--quiet]        limits come from ~/.config/loom/loom.json
    loom workers [stop <task>]
    loom schedule status|start|stop
    loom linear sync [--all] [--apply]
    loom logs <task>
"""
from __future__ import annotations

import argparse
import json
import os
import plistlib
import subprocess
import sys
from pathlib import Path

WORK = Path(__file__).resolve().parent
sys.path.insert(0, str(WORK))

import engine  # noqa: E402 — sibling module, resolved from this file's directory

LINEAR = WORK / "linear_sync.py"
CONFIG_PATH = Path(os.environ.get("LOOM_CONFIG") or Path.home() / ".config/loom/loom.json")

DEFAULTS = {
    "db": str(Path.home() / ".local/state/loom/work.db"),
    "worker": {
        "command": "opencode run --model opencode-go/deepseek-v4.1-flash",
        "ttl": "90m",
        "limits": {"implementer": 2, "reviewer": 2, "integrator": 1},
        "reviewer_identity": "opencode/reviewer-agent",
        "review_attempts": 2,
        "coordinator": "opencode/loom-coordinator",
    },
    "linear": {"config": str(Path.home() / ".config/loom/linear-portfolio.json")},
    "schedule": {"tick_label": "com.hritvik.loom-tick", "linear_label": "com.hritvik.loom-linear"},
}

GLOBAL_FLAGS = {"--root", "--agent", "--now", "--store", "--db"}
FRONT_DOOR = {"tick", "workers", "schedule", "linear", "logs"}


def _merge(base: dict, override: dict) -> dict:
    for key, value in override.items():
        if isinstance(value, dict) and isinstance(base.get(key), dict):
            _merge(base[key], value)
        else:
            base[key] = value
    return base


def load_config(path: Path = CONFIG_PATH) -> dict:
    config = json.loads(json.dumps(DEFAULTS))
    if path.is_file():
        _merge(config, json.loads(path.read_text()))
    return config


def state_home() -> Path:
    home = Path.home() / ".local/state/loom"
    home.mkdir(parents=True, exist_ok=True)
    return home


def split_globals(argv: list[str]) -> tuple[list[str], list[str]]:
    """Separate the engine's global flags from the command and its own flags."""
    globals_, rest, index = [], [], 0
    while index < len(argv):
        argument = argv[index]
        if argument in GLOBAL_FLAGS:
            globals_.append(argument)
            if index + 1 < len(argv):
                globals_.append(argv[index + 1])
                index += 1
        elif any(argument.startswith(flag + "=") for flag in GLOBAL_FLAGS):
            globals_.append(argument)
        else:
            rest.append(argument)
        index += 1
    return globals_, rest


# --------------------------------------------------------------------------
# tick
# --------------------------------------------------------------------------


def tick_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="loom tick", description="One policy pass.")
    parser.add_argument("--apply", action="store_true", help="claim, launch and review")
    parser.add_argument("--quiet", action="store_true", help="print nothing when the pass did nothing")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--implementer", "--max-implementer", dest="implementer", type=int)
    parser.add_argument("--reviewer", "--max-reviewer", dest="reviewer", type=int)
    parser.add_argument("--integrator", "--max-integrator", dest="integrator", type=int)
    parser.add_argument("--ttl")
    parser.add_argument("--worker-command")
    parser.add_argument("--reviewer-identity")
    parser.add_argument("--max-review-attempts", type=int)
    parser.add_argument("--coordinator")
    parser.add_argument("--java-home")
    return parser


def build_tick_args(argv: list[str], globals_: list[str], config: dict) -> list[str]:
    """The engine command for one pass, with policy defaults from loom.json."""
    args = tick_parser().parse_args(argv)
    worker = config["worker"]
    limits = worker.get("limits", {})
    command = list(globals_)
    if not any(item == "--db" or item.startswith("--db=") for item in command):
        command += ["--db", os.environ.get("WORK_DB") or config["db"]]
    command.append("tick")
    if args.apply:
        command.append("--apply")
    if args.quiet:
        command.append("--quiet")
    if args.json:
        command.append("--json")
    command += ["--ttl", args.ttl or str(worker.get("ttl", "90m"))]
    command += ["--worker-command",
                args.worker_command or worker.get("command", DEFAULTS["worker"]["command"])]
    command += ["--reviewer-identity",
                args.reviewer_identity or worker.get("reviewer_identity",
                                                     DEFAULTS["worker"]["reviewer_identity"])]
    command += ["--max-review-attempts",
                str(args.max_review_attempts if args.max_review_attempts is not None
                    else worker.get("review_attempts", DEFAULTS["worker"]["review_attempts"]))]
    command += ["--coordinator",
                args.coordinator or worker.get("coordinator", DEFAULTS["worker"]["coordinator"])]
    for role in ("implementer", "reviewer", "integrator"):
        value = getattr(args, role)
        if value is None:
            value = limits.get(role)
        if value is not None:
            command += [f"--max-{role}", str(value)]
    if args.java_home:
        command += ["--java-home", args.java_home]
    return command


def cmd_tick(argv: list[str], globals_: list[str], config: dict) -> int:
    return engine.main(build_tick_args(argv, globals_, config))


# --------------------------------------------------------------------------
# workers
# --------------------------------------------------------------------------


def pending_launches(config: dict) -> list[dict]:
    from store import make_store

    store = make_store(WORK, "sqlite", os.environ.get("WORK_DB") or config["db"])
    try:
        records = [record for _, record in store.read_events()]
    finally:
        store.close()
    latest: dict[str, dict] = {}
    for record in records:
        if record.get("event") == "launch" and record.get("task"):
            latest[record["task"]] = record
    return [record for record in latest.values() if record.get("state") == "pending"]


def pid_alive(pid) -> bool:
    try:
        os.kill(int(pid), 0)
    except (OSError, TypeError, ValueError):
        return False
    return True


def cmd_workers(args: argparse.Namespace, config: dict) -> int:
    launches = pending_launches(config)
    running = [item for item in launches if engine.launch_is_live(item)]
    if args.action == "stop":
        target = next((item for item in running if item.get("task") == args.task), None)
        if target is None:
            print(f"no running worker for {args.task}", file=sys.stderr)
            return 2
        os.kill(int(target["pid"]), 15)
        print(f"sent SIGTERM to {args.task} (pid {target['pid']})")
        return 0
    if not running:
        print("no workers running")
        return 0
    for item in running:
        print(f"{item['task']:<24} {item.get('role', ''):<12} pid {item['pid']:<8} "
              f"{item.get('branch') or '(no branch)'}")
        if item.get("worktree"):
            print(f"    worktree {item['worktree']}")
    return 0


# --------------------------------------------------------------------------
# schedule
# --------------------------------------------------------------------------


def plist_path(label: str) -> Path:
    return Path.home() / "Library/LaunchAgents" / f"{label}.plist"


def cmd_schedule(args: argparse.Namespace, config: dict) -> int:
    tick_label = config["schedule"].get("tick_label", DEFAULTS["schedule"]["tick_label"])
    linear_label = config["schedule"].get("linear_label", DEFAULTS["schedule"]["linear_label"])
    labels = [tick_label, linear_label]
    uid = os.getuid()
    if args.action == "start":
        started = 0
        for label in labels:
            plist = plist_path(label)
            if not plist.is_file():
                print(f"no plist at {plist}", file=sys.stderr)
                continue
            subprocess.run(["launchctl", "bootout", f"gui/{uid}/{label}"], capture_output=True)
            result = subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(plist)],
                                    capture_output=True, text=True)
            if result.returncode != 0:
                print(f"launchctl bootstrap failed for {label}: {result.stderr.strip()}",
                      file=sys.stderr)
                continue
            print(f"started {label}")
            started += 1
        return 0 if started else 2
    if args.action == "stop":
        for label in labels:
            subprocess.run(["launchctl", "bootout", f"gui/{uid}/{label}"], capture_output=True)
            print(f"stopped {label}")
        return 0
    listing = subprocess.run(["launchctl", "list"], capture_output=True, text=True).stdout
    jobs = [
        (tick_label, state_home() / "tick.log"),
        (linear_label, state_home() / "linear-sync.log"),
    ]
    for index, (job_label, job_log) in enumerate(jobs):
        if index:
            print()
        job_plist = plist_path(job_label)
        row = next((line for line in listing.splitlines() if job_label in line), None)
        print(f"label:  {job_label}")
        print(f"plist:  {job_plist} {'(present)' if job_plist.is_file() else '(missing)'}")
        if job_plist.is_file():
            try:
                interval = plistlib.loads(job_plist.read_bytes()).get("StartInterval")
            except Exception:
                interval = None
            if interval:
                print(f"interval: {interval}s")
        print(f"job:    {row.strip() if row else 'not loaded'}")
        print(f"log:    {job_log}")
        if job_log.is_file():
            tail = job_log.read_text(errors="replace").splitlines()[-3:]
            for line in tail:
                print(f"  | {line}")
    return 0


# --------------------------------------------------------------------------
# linear
# --------------------------------------------------------------------------


def cmd_linear(args: argparse.Namespace, config: dict) -> int:
    command = [sys.executable, str(LINEAR), "--config", config["linear"]["config"]]
    command += ["--all"] if args.all else (["--focus", args.focus] if args.focus else ["--all"])
    if args.apply:
        command.append("--apply")
    if args.if_changed:
        command.append("--if-changed")
    key_file = Path.home() / ".config/loom/linear.key"
    if not key_file.is_file():
        print(f"missing Linear API key at {key_file}", file=sys.stderr)
        return 2
    env = dict(os.environ)
    env["LINEAR_API_KEY"] = key_file.read_text().strip()
    return subprocess.run(command, env=env).returncode


# --------------------------------------------------------------------------
# logs
# --------------------------------------------------------------------------


def cmd_logs(args: argparse.Namespace, config: dict) -> int:
    log = state_home() / f"worker-{args.task.replace('/', '-')}.log"
    if not log.is_file():
        print(f"no log at {log}", file=sys.stderr)
        return 2
    lines = log.read_text(errors="replace").splitlines()[-args.lines:]
    for line in lines:
        print(line)
    return 0


# --------------------------------------------------------------------------
# dispatch
# --------------------------------------------------------------------------


def front_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="loom", add_help=False)
    sub = parser.add_subparsers(dest="command", required=True)

    workers = sub.add_parser("workers", help="what is running")
    workers.add_argument("action", nargs="?", choices=["list", "stop"], default="list")
    workers.add_argument("task", nargs="?")
    workers.set_defaults(func=cmd_workers)

    schedule = sub.add_parser("schedule", help="the launchd job")
    schedule.add_argument("action", choices=["status", "start", "stop"], default="status", nargs="?")
    schedule.set_defaults(func=cmd_schedule)

    linear = sub.add_parser("linear", help="the Linear projection")
    linear.add_argument("action", nargs="?", choices=["sync"], default="sync")
    linear.add_argument("--all", action="store_true")
    linear.add_argument("--focus")
    linear.add_argument("--apply", action="store_true")
    linear.add_argument("--if-changed", action="store_true")
    linear.set_defaults(func=cmd_linear)

    logs = sub.add_parser("logs", help="a worker's log")
    logs.add_argument("task")
    logs.add_argument("--lines", type=int, default=40)
    logs.set_defaults(func=cmd_logs)
    return parser


def usage() -> str:
    engine_commands = " ".join(sorted(engine.ENGINE_COMMANDS))
    return (
        "usage: loom <command> [options]\n\n"
        "engine:\n"
        f"  {engine_commands}\n\n"
        "unattended:\n"
        "  tick      one policy pass (--apply, --quiet); limits come from loom.json\n"
        "  workers   running workers; `workers stop <task>`\n"
        "  schedule  status | start | stop\n"
        "  linear    sync [--all] [--apply]\n"
        "  logs      <task> [--lines N]\n\n"
        "Every engine verb accepts --root, --db, --agent and --now before the verb.\n"
    )


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    globals_, rest = split_globals(argv)
    command = rest[0] if rest else None
    if command in engine.ENGINE_COMMANDS:
        return engine.main(argv)
    if command == "tick":
        return cmd_tick(rest[1:], globals_, load_config())
    if command in FRONT_DOOR:
        args = front_parser().parse_args(rest)
        if args.command == "workers" and args.action == "stop" and not args.task:
            print("workers stop needs a task id", file=sys.stderr)
            return 2
        return args.func(args, load_config())
    if not argv or argv in (["--help"], ["-h"]):
        print(usage(), end="")
        return 0 if argv else 2
    print(usage(), file=sys.stderr, end="")
    return 2


if __name__ == "__main__":
    sys.exit(main())
