def plist_path(label: str) -> Path:
    return Path.home() / "Library/LaunchAgents" / f"{label}.plist"


def cmd_schedule(args: argparse.Namespace, config: dict) -> int:
    tick_label = config["schedule"].get("tick_label", DEFAULTS["schedule"]["tick_label"])
    linear_label = config["schedule"].get("linear_label", DEFAULTS["schedule"]["linear_label"])
    labels = [tick_label, linear_label]
    uid = os.getuid()
    if args.action == "install":
        root = running_root()
        scripts = root / "capabilities/work"
        wrapper = Path.home() / ".config/loom/run-linear-sync.sh"
        wrapper.parent.mkdir(parents=True, exist_ok=True)
        wrapper.write_text(
            "#!/bin/sh\n"
            "# One scheduled pass of the Linear projection. Idempotent: a re-run changes nothing.\n"
            "set -e\n"
            'export LINEAR_API_KEY="$(cat "$HOME/.config/loom/linear.key")"\n'
            f'exec {sys.executable} "{scripts}/linear_sync.py" \\\n'
            '  --config "$HOME/.config/loom/linear-portfolio.json" --all --apply --if-changed\n')
        wrapper.chmod(0o755)
        tick_plist = plist_path(tick_label)
        linear_plist = plist_path(linear_label)
        tick_plist.parent.mkdir(parents=True, exist_ok=True)
        tick_plist.write_bytes(plistlib.dumps({
            "Label": tick_label,
            "ProgramArguments": [sys.executable, str(scripts / "loom"), "tick", "--apply", "--quiet"],
            "StartInterval": config["schedule"].get("tick_interval", 120),
            "RunAtLoad": True,
            "StandardOutPath": str(state_home() / "tick.log"),
            "StandardErrorPath": str(state_home() / "tick.log"),
            "EnvironmentVariables": {"PATH": os.environ.get("PATH", "/usr/bin:/bin")},
        }))
        linear_plist.write_bytes(plistlib.dumps({
            "Label": linear_label,
            "ProgramArguments": ["/bin/sh", str(wrapper)],
            "StartInterval": config["schedule"].get("linear_interval", 300),
            "RunAtLoad": True,
            "StandardOutPath": str(state_home() / "linear-sync.log"),
            "StandardErrorPath": str(state_home() / "linear-sync.log"),
            "EnvironmentVariables": {"PATH": "/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin"},
        }))
        print(f"engine:  {root}")
        print(f"wrote:   {tick_plist}")
        print(f"wrote:   {linear_plist}")
        print(f"wrote:   {wrapper}")
        if args.restart:
            return cmd_schedule(argparse.Namespace(action="start"), config)
        return 0
    if args.action == "start":
        started = 0
        for label in labels:
            plist = plist_path(label)
            if not plist.is_file():
                print(f"no plist at {plist}", file=sys.stderr)
                continue
            subprocess.run(["launchctl", "bootout", f"gui/{uid}/{label}"], capture_output=True)
            result = subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(plist)],
                                    capture_output=True, text=True)
            if result.returncode != 0:
                print(f"launchctl bootstrap failed for {label}: {result.stderr.strip()}",
                      file=sys.stderr)
                continue
            print(f"started {label}")
            started += 1
        return 0 if started else 2
    if args.action == "stop":
        for label in labels:
            subprocess.run(["launchctl", "bootout", f"gui/{uid}/{label}"], capture_output=True)
            print(f"stopped {label}")
        return 0
    listing = subprocess.run(["launchctl", "list"], capture_output=True, text=True).stdout
    jobs = [
        (tick_label, state_home() / "tick.log"),
        (linear_label, state_home() / "linear-sync.log"),
    ]
    for index, (job_label, job_log) in enumerate(jobs):
        if index:
            print()
        job_plist = plist_path(job_label)
        row = next((line for line in listing.splitlines() if job_label in line), None)
        print(f"label:  {job_label}")
        print(f"plist:  {job_plist} {'(present)' if job_plist.is_file() else '(missing)'}")
        if job_plist.is_file():
            try:
                interval = plistlib.loads(job_plist.read_bytes()).get("StartInterval")
            except Exception:
                interval = None
            if interval:
                print(f"interval: {interval}s")
        print(f"job:    {row.strip() if row else 'not loaded'}")
        print(f"log:    {job_log}")
        if job_log.is_file():
            tail = job_log.read_text(errors="replace").splitlines()[-3:]
            for line in tail:
                print(f"  | {line}")
    return 0


