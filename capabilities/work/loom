    "worker": {
        "command": "opencode run --model opencode-go/deepseek-v4.1-flash",
        "ttl": "90m",
        "limits": {"implementer": 2, "reviewer": 2, "integrator": 1},
        "reviewer_identity": "opencode/reviewer-agent",
        "review_attempts": 2,
        "coordinator": "opencode/loom-coordinator",
        "humans": [],
        "known_agents": ["opencode/reviewer-agent", "opencode/reviewer",
                         "opencode/loom-worker", "opencode/loom-coordinator", "codex-agent"],
        "max_integrate": 1,
        "auto_integrate": False,
        "stuck_after": "3h",
    },
    "linear": {"config": str(Path.home() / ".config/loom/linear-portfolio.json")},
    "schedule": {"tick_label": "local.loom-tick", "linear_label": "local.loom-linear"},
}

GLOBAL_FLAGS = {"--root", "--agent", "--now", "--store", "--db"}
FRONT_DOOR = {"tick", "workers", "schedule", "linear", "logs", "integration-plan", "deploy"}


def _merge(base: dict, override: dict) -> dict:
    for key, value in override.items():
        if isinstance(value, dict) and isinstance(base.get(key), dict):
            _merge(base[key], value)
        else:
            base[key] = value
    return base


def load_config(path: Path = CONFIG_PATH) -> dict:
    config = json.loads(json.dumps(DEFAULTS))
    if path.is_file():
        _merge(config, json.loads(path.read_text()))
    return config


def state_home() -> Path:
    home = Path.home() / ".local/state/loom"
    home.mkdir(parents=True, exist_ok=True)
    return home


def engine_dir() -> Path:
    """The promoted release tree, or this checkout when nothing is promoted."""
    override = os.environ.get("LOOM_ENGINE")
    if override:
        return Path(override).expanduser()
    return state_home() / "engine"


def engine_prev() -> Path:
    return engine_dir().with_name(engine_dir().name + ".prev")


def release_file() -> Path:
    return engine_dir().with_name("engine.release")


def repo_root() -> Path:
    return WORK.parents[1]


def running_root() -> Path:
    """The tree the launchd jobs actually execute: the release if one exists."""
    if (engine_dir() / "capabilities/work/loom").is_file():
        return engine_dir()
    return repo_root()


def read_release() -> dict:
    try:
        return json.loads(release_file().read_text())
    except (OSError, ValueError):
        return {}


def write_release(data: dict) -> None:
    release_file().parent.mkdir(parents=True, exist_ok=True)
    tmp = release_file().with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    os.replace(tmp, release_file())


def git_text(repo: Path, *args: str) -> str:
    result = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else ""


def tree_digest(root: Path) -> str:
    """A digest of the released source, immune to what running it leaves behind.

    `__pycache__` appears the first time the release executes, so including it made the recorded
    digest false within minutes of promoting. The digest is only useful if it can be re-verified.
    """
    digest = hashlib.sha256()
    for path in sorted(root.rglob("*")):
        if not path.is_file():
            continue
        if path.suffix == ".pyc" or "__pycache__" in path.parts:
            continue
        digest.update(str(path.relative_to(root)).encode())
        digest.update(path.read_bytes())
    return digest.hexdigest()


def cmd_deploy(args: argparse.Namespace, config: dict) -> int:
    if args.action == "path":
        print(running_root())
        return 0
    repo = Path(args.repo).expanduser() if getattr(args, "repo", None) else repo_root()
    if args.action == "status":
        released = read_release().get("current") or {}
        dev = git_text(repo, "rev-parse", "HEAD")
        dirty = git_text(repo, "status", "--porcelain")
        plist = plist_path(config["schedule"].get("tick_label", DEFAULTS["schedule"]["tick_label"]))
        scheduled = ""
        if plist.is_file():
            try:
                arguments = plistlib.loads(plist.read_bytes()).get("ProgramArguments") or []
                scheduled = arguments[1] if len(arguments) > 1 else ""
            except Exception:
                scheduled = ""
        print(f"development: {repo}")
        print(f"  head:      {dev or 'not a git repository'}"
              f"{' (dirty: ' + str(len(dirty.splitlines())) + ' file(s))' if dirty else ''}")
        print(f"release:    {engine_dir()}")
        print(f"  head:      {released.get('commit', 'none')}")
        if released:
            print(f"  promoted:  {released.get('promoted_at')}")
        present = (engine_dir() / "capabilities/work/loom").is_file()
        print(f"  tree:      {'present' if present else 'absent'}")
        intact = True
        if present and released.get("tree"):
            actual = tree_digest(engine_dir())
            intact = actual == released["tree"]
            print(f"  digest:    {'verified' if intact else 'MISMATCH'} "
                  f"(recorded {released['tree'][:12]}, tree {actual[:12]})")
        print(f"schedule:   {scheduled or 'unknown'}")
        pinned = bool(scheduled) and str(engine_dir()) in scheduled
        if not released:
            print("verdict:    UNPINNED — the scheduler runs the development checkout")
        elif dev and released.get("commit") != dev:
            print("verdict:    STALE — development is ahead of the release; promote when reviewed")
        elif not pinned:
            print("verdict:    UNPINNED — a release exists but the schedule still points at development")
        elif not intact:
            print("verdict:    DRIFTED — the release tree no longer matches its recorded digest; "
                  "promote again")
        else:
            print("verdict:    PINNED — the scheduler runs the promoted release, digest verified")
        return 0
    if args.action == "promote":
        if not (repo / ".git").exists():
            print(f"{repo} is not a git repository; promote from the development checkout",
                  file=sys.stderr)
            return 2
        dirty = git_text(repo, "status", "--porcelain")
        if dirty:
            print(f"refusing to promote: {len(dirty.splitlines())} uncommitted change(s) in {repo}",
                  file=sys.stderr)
            return 2
        commit = git_text(repo, "rev-parse", args.ref or "HEAD")
        if not commit:
            print(f"cannot resolve {args.ref or 'HEAD'} in {repo}", file=sys.stderr)
            return 2
        current = (read_release().get("current") or {}).get("commit")
        if commit == current and (engine_dir() / "capabilities/work/loom").is_file():
            print(f"{commit[:12]} is already the release")
            return 0
        staging = Path(tempfile.mkdtemp(prefix="loom-release-"))
        try:
            archive = subprocess.run(["git", "-C", str(repo), "archive", "--format=tar", commit],
                                     capture_output=True)
            if archive.returncode != 0:
                print(f"git archive failed: {archive.stderr.decode(errors='replace').strip()}",
                      file=sys.stderr)
                return 2
            extract = subprocess.run(["tar", "-x", "-C", str(staging)], input=archive.stdout)
            if extract.returncode != 0:
                print("could not extract the release archive", file=sys.stderr)
                return 2
            if not (staging / "capabilities/work/loom").is_file():
                print("the archive does not contain capabilities/work/loom", file=sys.stderr)
                return 2
            if engine_dir().exists():
                if engine_prev().exists():
                    shutil.rmtree(engine_prev())
                engine_dir().rename(engine_prev())
            engine_dir().parent.mkdir(parents=True, exist_ok=True)
            staging.rename(engine_dir())
        finally:
            if staging.exists():
                shutil.rmtree(staging, ignore_errors=True)
        write_release({
            "current": {
                "commit": commit,
                "promoted_at": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                "tree": tree_digest(engine_dir()),
            },
            "previous": read_release().get("current"),
        })
        print(f"promoted {commit[:12]} to {engine_dir()}")
        print("restart the jobs to run it: loom schedule install --restart")
        return 0
    if args.action == "rollback":
        if not engine_prev().exists():
            print("no previous release to roll back to", file=sys.stderr)
            return 2
        retired = engine_dir().with_name("engine.retired")
        if retired.exists():
            shutil.rmtree(retired)
        if engine_dir().exists():
            engine_dir().rename(retired)
        engine_prev().rename(engine_dir())
        if retired.exists():
            retired.rename(engine_prev())
        data = read_release()
        data["current"], data["previous"] = data.get("previous"), data.get("current")
        write_release(data)
        print(f"rolled back to {(data.get('current') or {}).get('commit', 'previous')[:12]}")
        print("restart the jobs: loom schedule install --restart")
        return 0
    print(f"unknown release action {args.action}", file=sys.stderr)
    return 2


def split_globals(argv: list[str]) -> tuple[list[str], list[str]]:
    """Separate the engine's global flags from the command and its own flags."""
    globals_, rest, index = [], [], 0
    while index < len(argv):
        argument = argv[index]
        if argument in GLOBAL_FLAGS:
            globals_.append(argument)
            if index + 1 < len(argv):
                globals_.append(argv[index + 1])
                index += 1
        elif any(argument.startswith(flag + "=") for flag in GLOBAL_FLAGS):
            globals_.append(argument)
        else:
            rest.append(argument)
        index += 1
    return globals_, rest


