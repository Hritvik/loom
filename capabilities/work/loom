def tick_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="loom tick", description="One policy pass.")
    parser.add_argument("--apply", action="store_true", help="claim, launch and review")
    parser.add_argument("--quiet", action="store_true", help="print nothing when the pass did nothing")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--implementer", "--max-implementer", dest="implementer", type=int)
    parser.add_argument("--reviewer", "--max-reviewer", dest="reviewer", type=int)
    parser.add_argument("--integrator", "--max-integrator", dest="integrator", type=int)
    parser.add_argument("--ttl")
    parser.add_argument("--worker-command")
    parser.add_argument("--reviewer-identity")
    parser.add_argument("--max-review-attempts", type=int)
    parser.add_argument("--coordinator")
    parser.add_argument("--human", action="append", dest="humans")
    parser.add_argument("--known-agent", action="append", dest="known_agents")
    parser.add_argument("--max-integrate", type=int)
    parser.add_argument("--integrate", action="store_true",
                        help="record integration for already-merged reviewed work")
    parser.add_argument("--stuck-after")
    parser.add_argument("--no-integrate", action="store_true")
    parser.add_argument("--java-home")
    return parser


def build_tick_args(argv: list[str], globals_: list[str], config: dict) -> list[str]:
    """The engine command for one pass, with policy defaults from loom.json."""
    args = tick_parser().parse_args(argv)
    worker = config["worker"]
    limits = worker.get("limits", {})
    command = list(globals_)
    if not any(item == "--db" or item.startswith("--db=") for item in command):
        command += ["--db", os.environ.get("WORK_DB") or config["db"]]
    command.append("tick")
    if args.apply:
        command.append("--apply")
    if args.quiet:
        command.append("--quiet")
    if args.json:
        command.append("--json")
    command += ["--ttl", args.ttl or str(worker.get("ttl", "90m"))]
    command += ["--worker-command",
                args.worker_command or worker.get("command", DEFAULTS["worker"]["command"])]
    command += ["--reviewer-identity",
                args.reviewer_identity or worker.get("reviewer_identity",
                                                     DEFAULTS["worker"]["reviewer_identity"])]
    command += ["--max-review-attempts",
                str(args.max_review_attempts if args.max_review_attempts is not None
                    else worker.get("review_attempts", DEFAULTS["worker"]["review_attempts"]))]
    command += ["--coordinator",
                args.coordinator or worker.get("coordinator", DEFAULTS["worker"]["coordinator"])]
    for human in (args.humans or worker.get("humans", DEFAULTS["worker"]["humans"])):
        command += ["--human", human]
    for agent in (args.known_agents or worker.get("known_agents",
                                                  DEFAULTS["worker"]["known_agents"])):
        command += ["--known-agent", agent]
    command += ["--max-integrate",
                str(args.max_integrate if args.max_integrate is not None
                    else worker.get("max_integrate", DEFAULTS["worker"]["max_integrate"]))]
    command += ["--stuck-after",
                args.stuck_after or worker.get("stuck_after", DEFAULTS["worker"]["stuck_after"])]
    if args.no_integrate or (not args.integrate and not worker.get("auto_integrate", True)):
        command.append("--no-integrate")
    for role in ("implementer", "reviewer", "integrator"):
        value = getattr(args, role)
        if value is None:
            value = limits.get(role)
        if value is not None:
            command += [f"--max-{role}", str(value)]
    if args.java_home:
        command += ["--java-home", args.java_home]
    return command


def cmd_tick(argv: list[str], globals_: list[str], config: dict) -> int:
    return engine.main(build_tick_args(argv, globals_, config))


def build_plan_args(argv: list[str], globals_: list[str], config: dict) -> list[str]:
    """The worklist command, with the same identities the tick uses."""
    worker = config.get("worker", {})
    args = list(argv)
    if "--reviewer-identity" not in args:
        args += ["--reviewer-identity",
                 str(worker.get("reviewer_identity", DEFAULTS["worker"]["reviewer_identity"]))]
    if "--implementer" not in args:
        args += ["--implementer", str(worker.get("implementer_identity", "opencode/loom-worker"))]
    if "--coordinator" not in args:
        args += ["--coordinator", str(worker.get("coordinator", DEFAULTS["worker"]["coordinator"]))]
    if "--human" not in args:
        for human in worker.get("humans", ()):
            args += ["--human", str(human)]
    if "--known-agent" not in args:
        for agent in worker.get("known_agents", ()):
            args += ["--known-agent", str(agent)]
    return globals_ + ["integration-plan"] + args


def cmd_plan(argv: list[str], globals_: list[str], config: dict) -> int:
    return engine.main(build_plan_args(argv, globals_, config))


