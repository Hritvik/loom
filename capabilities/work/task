    <span id="level">100%</span>
  </div>
</header>
<div class="wrap"><svg id="canvas" width="{width}" height="{height}"
  xmlns="http://www.w3.org/2000/svg">
<rect width="100%" height="100%" fill="#0b1120"/>
{chr(10).join(links)}
{chr(10).join(nodes)}
