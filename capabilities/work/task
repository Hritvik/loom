                 "blocked", "reviewed", "released"}


def graph_nodes(registry: dict, program: str | None, board: str | None, only_open: bool,
                focus: str | None) -> list[dict]:
    tasks = registry["tasks"]
    if program:
        tasks = [task for task in tasks if task.get("program") == program]
    if board:
        tasks = [task for task in tasks if task.get("board") == board]
    if only_open:
        tasks = [task for task in tasks if task.get("status") in OPEN_STATUSES]
    if focus:
        find_task(registry, focus)
        index = dependents_index(registry)
        by_id = {task["id"]: task for task in registry["tasks"]}
        keep = {focus} | set(transitive_dependents(index, focus))
        seen = {focus}
        stack = [focus]
        while stack:
            current = stack.pop()
            for dep in task_edges(registry, current):
                if dep not in seen:
                    seen.add(dep)
                    keep.add(dep)
                    stack.append(dep)
        tasks = [by_id[task_id] for task_id in keep if task_id in by_id]
    return sorted(tasks, key=lambda task: (task.get("program", ""), task["id"]))


def graph_layout(registry: dict, tasks: list[dict]) -> tuple[dict[str, tuple[int, int]], dict[str, list[str]]]:
    """Layer tasks so dependencies sit left of dependents; return positions and edges."""
    ids = {task["id"] for task in tasks}
    deps = {task["id"]: [dep for dep in task_edges(registry, task["id"]) if dep in ids] for task in tasks}
    layer: dict[str, int] = {}

    def depth(task_id: str, seen: frozenset[str] = frozenset()) -> int:
        if task_id in layer:
            return layer[task_id]
        if task_id in seen:
            return 0
        value = 0
        for dep in deps.get(task_id, []):
            value = max(value, depth(dep, seen | {task_id}) + 1)
        layer[task_id] = value
        return value

    for task in tasks:
        depth(task["id"])
    rows: dict[int, int] = {}
    positions: dict[str, tuple[int, int]] = {}
    for task in sorted(tasks, key=lambda t: (layer[t["id"]], t.get("program", ""), t["id"])):
        column = layer[task["id"]]
        row = rows.get(column, 0)
        rows[column] = row + 1
        positions[task["id"]] = (column, row)
    edges = {task["id"]: deps[task["id"]] for task in tasks}
    return positions, edges


def render_graph_text(registry: dict, tasks: list[dict], positions, edges) -> str:
    by_id = {task["id"]: task for task in registry["tasks"]}
    lines = []
    blocked = [task for task in tasks if task.get("status") == "blocked"]
    if blocked:
        lines.append("Blocked, and what each one releases:")
        for task in sorted(blocked, key=lambda t: t["id"]):
            needs = task.get("blocked_needs") or "agent"
            downstream = transitive_dependents(dependents_index(registry), task["id"])
            lines.append(f"  {task['id']:<22} {task.get('status'):<9} needs {needs:<6}"
                         f" unblocks {len(downstream)}")
    lines.append("")
    lines.append("Chains (dependency on the left, dependent on the right):")
    roots = [task for task in tasks if not edges.get(task["id"])]
    for root in sorted(roots, key=lambda t: (positions[t["id"]][0], t["id"]))[:40]:
        lines.append(f"  {root['id']}  [{root.get('status')}]  {root.get('title', '')[:60]}")
        for dependent in transitive_dependents(dependents_index(registry), root["id"]):
            if dependent in {task["id"] for task in tasks}:
                other = by_id[dependent]
                lines.append(f"    -> {dependent}  [{other.get('status')}]  "
                             f"{other.get('title', '')[:52]}")
    return "\n".join(lines)


def render_graph_mermaid(tasks: list[dict], edges) -> str:
    lines = ["graph LR"]
    for task in tasks:
        label = task["id"].replace("/", "<br/>")
        lines.append(f'  n_{task["id"].replace("/", "_").replace(".", "_")}["{label}"]')
    for task in tasks:
        source = f'n_{task["id"].replace("/", "_").replace(".", "_")}'
        for dep in edges.get(task["id"], []):
            target = f'n_{dep.replace("/", "_").replace(".", "_")}'
            lines.append(f"  {target} --> {source}")
    for status in sorted({task.get("status") for task in tasks}):
        members = [f'n_{task["id"].replace("/", "_").replace(".", "_")}'
                   for task in tasks if task.get("status") == status]
        lines.append(f"  classDef {status.replace('-', '_')} fill:{STATUS_COLOURS[status]},"
                     f"color:#fff,stroke:#111;")
        lines.append(f"  class {','.join(members)} {status.replace('-', '_')};")
    return "\n".join(lines)


