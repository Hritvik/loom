def assert_no_cycle(registry: dict) -> None:
    graph = {task["id"]: [] for task in registry["tasks"]}
    for edge in registry["edges"]:
        if edge.get("kind", "depends-on") != "depends-on":
            continue
        if edge["from"] in graph and edge["to"] in graph:
            graph[edge["from"]].append(edge["to"])
    for task in registry["tasks"]:
        for dep in task.get("depends_on", []) or []:
            if dep in graph:
                graph[task["id"]].append(dep)
    visiting, visited = set(), set()

    def visit(node: str, trail: list[str]) -> None:
        if node in visiting:
            raise WorkError("dependency cycle: " + " -> ".join(trail + [node]))
        if node in visited:
            return
        visiting.add(node)
        for neighbour in graph.get(node, []):
            visit(neighbour, trail + [node])
        visiting.remove(node)
        visited.add(node)

    for node in graph:
        visit(node, [])


def verify_event_chain(records: list[tuple[bytes, dict]]) -> list[str]:
    errors = []
    previous_raw = None
    last_ts = None
    for index, (raw, record) in enumerate(records, start=1):
        if record.get("seq") != index:
            errors.append(f"seq {record.get('seq')} at line {index}")
        expected = hashlib.sha256(previous_raw).hexdigest() if previous_raw else ZERO_HASH
        if record.get("prev") != expected:
            errors.append(f"line {index}: prev hash mismatch")
        ts = record.get("ts")
        try:
            moment = parse_time(ts)
            if last_ts and moment < last_ts:
                errors.append(f"line {index}: timestamp moved backwards")
            last_ts = moment
        except (TypeError, ValueError):
            errors.append(f"line {index}: invalid timestamp {ts!r}")
        previous_raw = raw
    return errors


def verify_registry_events(registry: dict, records: list[tuple[bytes, dict]]) -> list[str]:
    errors = []
    by_id = {task["id"]: task for task in registry.get("tasks", [])}
    last: dict[str, dict] = {}
    for _, record in records:
        if record.get("task"):
            last[record["task"]] = record
    for task_id, record in last.items():
        task = by_id.get(task_id)
        if task is None:
            errors.append(f"event log references unknown task {task_id}")
            continue
        if record.get("revision") != task.get("revision"):
            errors.append(
                f"{task_id}: last event revision {record.get('revision')} != registry {task.get('revision')}")
        if record.get("status") != task.get("status"):
            errors.append(
                f"{task_id}: last event status {record.get('status')!r} != registry {task.get('status')!r}")
        claim = task.get("claim") or {}
        if claim.get("agent") and record.get("event") in {"claim", "renew", "takeover"}:
            if record.get("agent") != claim.get("agent"):
                errors.append(f"{task_id}: last claim event agent does not match registry claim")
    return errors


def require_agent(args) -> str:
    agent = args.agent or os.environ.get("WORK_AGENT")
    if not agent:
        raise WorkError("mutating commands require --agent or WORK_AGENT (e.g. opencode/alpha-agent-3)")
    return agent


