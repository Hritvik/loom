def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command == "board" and args.action == "sync" and not args.board:
        parser.error("board sync requires --board")
    store = make_store(Path(args.root).expanduser(), args.store, args.db)
    try:
        with store.lock():
            return args.func(args, store)
    except WorkError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
