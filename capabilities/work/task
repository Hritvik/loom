  .bar {{ display:flex; gap:8px; align-items:center; margin-top:10px; font-size:12px; }}
  .bar button {{ background:transparent; color:inherit; border:1px solid var(--border, #e5e7eb);
                 border-radius:6px; padding:3px 10px; cursor:pointer; font-size:12px; }}
  .wrap {{ overflow:auto; }}
  #canvas {{ transform-origin: top left; }}
</style></head>
<body>
<header>
  <h1>Work graph</h1>
  <div class="meta">{len(tasks)} tasks · {sum(len(v) for v in edges.values())} dependency edges ·
    {len(blocked)} blocked · generated {dt.datetime.now(dt.timezone.utc):%Y-%m-%d %H:%M}Z</div>
