def cmd_edge(args, store: Store) -> int:
    registry = store.load()
    edges = registry.setdefault("edges", [])
    if args.action == "list":
        if not edges:
            print("no edges")
            return 0
        for edge in edges:
            print(f"{edge['from']:<24} -> {edge['to']:<24} {edge.get('kind', 'depends-on')}")
        return 0

    agent = require_agent(args)
    if not args.source or not args.target:
        raise WorkError("edge add/remove requires --from and --to")
    find_task(registry, args.source)
    find_task(registry, args.target)
    if args.source == args.target:
        raise WorkError("an edge cannot point at itself")
    kind = args.kind
    existing = next((edge for edge in edges if edge["from"] == args.source
                     and edge["to"] == args.target and edge.get("kind", "depends-on") == kind), None)
    if args.action == "add":
        if existing:
            raise WorkError(f"edge already exists: {args.source} -> {args.target} ({kind})")
        edges.append({"from": args.source, "to": args.target, "kind": kind})
        assert_no_cycle(registry)
        store.save()
        store.append_event(event="edge", agent=agent, action="add", source=args.source,
                           target=args.target, kind=kind, now=args.now)
        print(f"added edge {args.source} -> {args.target} ({kind})")
        return 0

    if not existing:
        raise WorkError(f"edge not found: {args.source} -> {args.target} ({kind})")
    edges.remove(existing)
    store.save()
    store.append_event(event="edge", agent=agent, action="remove", source=args.source,
                       target=args.target, kind=kind, now=args.now)
    print(f"removed edge {args.source} -> {args.target} ({kind})")
    return 0


def cmd_create(args, store: Store) -> int:
    agent = require_agent(args)
    now = parse_now(args.now)
    registry = store.load()
    if not ID_PATTERN.match(args.id):
        raise WorkError(f"invalid task id {args.id!r}; expected <program>/<NAME>, e.g. iam/W-15")
    if any(task["id"] == args.id for task in registry["tasks"]):
        raise WorkError(f"task {args.id} already exists; ids are never reused or renumbered")
    board = find_board(registry, args.board)
    status = args.status
    if status not in {"draft", "planned", "ready"}:
        raise WorkError("new tasks may start as draft, planned or ready")
    task = {
        "id": args.id,
        "board": args.board,
        "program": args.program or args.id.split("/", 1)[0],
        "owner_repo": args.owner_repo or board["repo"],
        "title": args.title,
        "goal": args.goal or args.title,
        "status": status,
        "revision": 0,
        "created_at": iso(now),
        "updated_at": iso(now),
    }
    if args.depends_on:
        deps = []
        for dep in args.depends_on:
            find_task(registry, dep)
            if dep == args.id:
                raise WorkError("a task cannot depend on itself")
            deps.append(dep)
        task["depends_on"] = deps
    if args.write_path:
        task["write_paths"] = sorted({normalized_path(p) for p in args.write_path})
    if args.acceptance:
        task["acceptance"] = list(args.acceptance)
    registry["tasks"].append(task)
    assert_no_cycle(registry)
    store.save()
    store.append_event(event="create", task=task["id"], agent=agent, status=status,
                       revision=0, now=args.now)
    print(f"created {task['id']} on {task['board']} as {status} (revision 0)")
    return 0


def cmd_list(args, store: Store) -> int:
    registry = store.load()
    now = parse_now(args.now)
    tasks = registry["tasks"]
    if args.board:
        tasks = [task for task in tasks if task["board"] == args.board]
    if args.state:
        wanted = {s.strip() for s in args.state.split(",")}
        tasks = [task for task in tasks if task.get("status") in wanted]
    if args.mine:
        tasks = [task for task in tasks if claim_owner(task) == args.mine]
    if args.awaiting:
        tasks = [task for task in tasks if task.get("status") == "blocked"
                 and (task.get("blocked_needs") or "agent") == args.awaiting]
    weights: dict[str, int] = {}
    if args.ready:
        index = dependents_index(registry)
        selected = []
        for task in tasks:
            if task.get("status") not in CLAIMABLE_FROM:
                continue
            satisfied, _ = dependencies_met(registry, task)
            if not satisfied:
                continue
            if write_path_conflicts(registry, task, now):
                continue
            selected.append(task)
            weights[task["id"]] = len(transitive_dependents(index, task["id"]))
        tasks = sorted(selected, key=lambda task: (-weights.get(task["id"], 0), task["id"]))
    if args.json:
        print(json.dumps(tasks, indent=2, default=str))
        return 0
    if not tasks:
        print("no tasks match")
        return 0
    for task in tasks:
        claim = task.get("claim") or {}
        suffix = f"  @{claim.get('agent')} until {claim.get('lease_expires')}" if claim else ""
        if args.ready and weights.get(task["id"]):
            suffix += f"  +{weights[task['id']]} downstream"
        print(f"{task['id']:<22} {task.get('status'):<11} r{task.get('revision', 0):<4}"
              f" {task.get('title', '')}{suffix}")
    return 0


def cmd_search(args, store: Store) -> int:
    """Find tasks by question rather than by namespace."""
    registry = store.load()
    terms = [term.lower() for term in args.terms if term.strip()]
    if not terms:
        raise WorkError("search requires at least one term")
    scored = []
    for task in registry["tasks"]:
        fields = [
            (task.get("id") or "", 6),
            (task.get("title") or "", 4),
            (task.get("goal") or "", 3),
            (" ".join(task.get("write_paths") or []), 2),
            (task.get("evidence") or "", 2),
            (task.get("program") or "", 1),
            (task.get("board") or "", 1),
        ]
        score = 0
        matched = 0
        for term in terms:
            best = 0
            for text, weight in fields:
                if term in text.lower():
                    best = max(best, weight)
            if best:
                matched += 1
                score += best
        if matched == len(terms):
            scored.append((score, task))
    scored.sort(key=lambda item: (-item[0], item[1]["id"]))
    if args.limit:
        scored = scored[:args.limit]
    if args.json:
        print(json.dumps([task for _, task in scored], indent=2, default=str))
        return 0
    if not scored:
        print("no tasks match")
        return 0
    for _, task in scored:
        claim = task.get("claim") or {}
        suffix = f"  @{claim.get('agent')}" if claim else ""
        print(f"{task['id']:<22} {task.get('status'):<11} r{task.get('revision', 0):<4}"
              f" {task.get('title', '')}{suffix}")
    return 0


def cmd_dependents(args, store: Store) -> int:
    """Who is waiting on this task, directly and through the chain."""
    registry = store.load()
    task = find_task(registry, args.task)
    index = dependents_index(registry)
    direct = sorted(set(index.get(task["id"], [])))
    downstream = transitive_dependents(index, task["id"])
    by_id = {item["id"]: item for item in registry["tasks"]}
    if args.json:
        print(json.dumps({
            "task": task["id"],
            "direct": [{"id": dep, "status": by_id.get(dep, {}).get("status")} for dep in direct],
            "transitive": [{"id": dep, "status": by_id.get(dep, {}).get("status")}
                           for dep in downstream],
        }, indent=2, default=str))
        return 0
    if not downstream:
        print(f"{task['id']} blocks nothing")
        return 0
    print(f"{task['id']} blocks {len(direct)} directly and {len(downstream)} transitively")
    for dep in downstream:
        marker = "*" if dep in direct else " "
        other = by_id.get(dep, {})
        print(f" {marker} {dep:<22} {other.get('status', '?'):<11} {other.get('title', '')}")
    return 0


