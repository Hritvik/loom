def find_task(registry: dict, task_id: str) -> dict:
    for task in registry["tasks"]:
        if task["id"] == task_id:
            return task
    known = [task["id"] for task in registry["tasks"]]
    close = difflib.get_close_matches(task_id, known, n=3)
    hint = f"; did you mean {', '.join(close)}?" if close else ""
    raise WorkError(f"unknown task {task_id}{hint}")


def find_board(registry: dict, board_id: str) -> dict:
    for board in registry["boards"]:
        if board["id"] == board_id:
            return board
    raise WorkError(f"unknown board {board_id}")


def task_edges(registry: dict, task_id: str) -> list[str]:
    """Return task ids that `task_id` depends on.

    Edge direction: `from` depends on `to` (for `depends-on` edges).
    `provider-parity` edges are advisory and do not gate readiness.
    """
    deps = [edge["to"] for edge in registry["edges"]
            if edge.get("kind", "depends-on") == "depends-on" and edge["from"] == task_id]
    task = find_task(registry, task_id)
    for dep in task.get("depends_on", []) or []:
        if dep not in deps:
            deps.append(dep)
    return deps


def dependencies_met(registry: dict, task: dict) -> tuple[bool, list[str]]:
    unmet = []
    for dep in task_edges(registry, task["id"]):
        try:
            other = find_task(registry, dep)
        except WorkError:
            unmet.append(f"{dep} (unknown)")
            continue
        if other.get("status") not in DEP_SATISFIED:
            unmet.append(f"{dep} ({other.get('status')})")
    return not unmet, unmet

def dependents_index(registry: dict) -> dict[str, list[str]]:
    """Reverse of the depends-on graph: task id -> ids that depend on it."""
    index: dict[str, list[str]] = {}
    for task in registry["tasks"]:
        deps = [edge["to"] for edge in registry.get("edges", [])
                if edge.get("kind", "depends-on") == "depends-on" and edge["from"] == task["id"]]
        for dep in task.get("depends_on", []) or []:
            if dep not in deps:
                deps.append(dep)
        for dep in deps:
            index.setdefault(dep, []).append(task["id"])
    return index


def transitive_dependents(index: dict[str, list[str]], task_id: str) -> list[str]:
    """Everything downstream of a task, following the reverse graph."""
    seen: set[str] = set()
    stack = list(index.get(task_id, []))
    while stack:
        current = stack.pop()
        if current in seen:
            continue
        seen.add(current)
        stack.extend(index.get(current, []))
    return sorted(seen)


def normalized_path(value: str) -> str:
    return value.strip().rstrip("/")


def paths_overlap(left: str, right: str) -> bool:
    a, b = normalized_path(left), normalized_path(right)
    if not a or not b:
        return False
    return a == b or a.startswith(b + "/") or b.startswith(a + "/")


def lease_expiry(task: dict) -> dt.datetime | None:
    claim = task.get("claim") or {}
    value = claim.get("lease_expires")
    return parse_time(value) if value else None


def active_claim(task: dict, now: dt.datetime) -> bool:
    if task.get("status") not in ACTIVE_STATES or not task.get("claim"):
        return False
    expiry = lease_expiry(task)
    return bool(expiry and expiry > now)


PATH_LOCK_STATUSES = {"claimed", "red"}


def holds_path_lock(task: dict, now: dt.datetime) -> bool:
    """Green is finished work: it keeps its lease so findings can be fixed, but not the directory."""
    if task.get("status") not in PATH_LOCK_STATUSES or not task.get("claim"):
        return False
    expiry = lease_expiry(task)
    return bool(expiry and expiry > now)


def write_path_conflicts(registry: dict, task: dict, now: dt.datetime) -> list[str]:
    conflicts = []
    mine = task.get("write_paths", []) or []
    for other in registry["tasks"]:
        if other["id"] == task["id"] or not holds_path_lock(other, now):
            continue
        for left in mine:
            for right in other.get("write_paths", []) or []:
                if paths_overlap(left, right):
                    conflicts.append(f"{left} overlaps {other['id']}:{right} ({other['claim'].get('agent')})")
    return conflicts


def require_state(task: dict, allowed: set[str], operation: str) -> None:
    if task.get("status") not in allowed:
        raise WorkError(
            f"cannot {operation} {task['id']}: status is {task.get('status')!r}, expected {sorted(allowed)}"
        )


def require_revision(task: dict, revision: int) -> None:
    current = int(task.get("revision", 0))
    if revision != current:
        raise WorkError(
            f"revision conflict on {task['id']}: you passed {revision}, registry has {current}. "
            "Re-read the task and retry (compare-and-swap)."
        )


def claim_owner(task: dict) -> str | None:
    return (task.get("claim") or {}).get("agent")


def require_owner(task: dict, agent: str) -> None:
    owner = claim_owner(task)
    if owner != agent:
        raise WorkError(f"{task['id']} is claimed by {owner!r}, not {agent!r}")


def bump(task: dict, status: str, now: dt.datetime) -> None:
    task["status"] = status
    task["revision"] = int(task.get("revision", 0)) + 1
    task["updated_at"] = iso(now)


def summarize(task: dict, registry: dict) -> str:
    deps = task_edges(registry, task["id"])
    satisfied, unmet = dependencies_met(registry, task)
    claim = task.get("claim") or {}
    index = dependents_index(registry)
    direct = sorted(set(index.get(task["id"], [])))
    downstream = transitive_dependents(index, task["id"])
    blocks = ", ".join(direct) if direct else "-"
    if len(downstream) > len(direct):
        blocks += f"  ({len(downstream)} downstream)"
    lines = [
        f"{task['id']}  [{task.get('status')}]  revision {task.get('revision', 0)}",
        f"  board:    {task.get('board')}",
        f"  program:  {task.get('program', '-')}",
        f"  title:    {task.get('title', '-')}",
        f"  deps:     {', '.join(deps) if deps else '-'}"
        + (f"  UNMET: {', '.join(unmet)}" if unmet else "  (satisfied)" if deps else ""),
        f"  blocks:   {blocks}",
        f"  paths:    {', '.join(task.get('write_paths', [])) or '-'}",
    ]
    if claim:
        lines.append(
            f"  claim:    {claim.get('agent')} until {claim.get('lease_expires')} "
            f"(base revision {claim.get('base_revision')})"
        )
    if task.get("evidence"):
        lines.append(f"  evidence: {task['evidence']}")
    if task.get("review"):
        lines.append(f"  review:   {task['review'].get('decision')} by {task['review'].get('reviewer')}")
    return "\n".join(lines)


