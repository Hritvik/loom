    columns = max(column for column, _ in positions.values()) + 1
    rows = max(row for _, row in positions.values()) + 1
    width = (rows * 280 if vertical else columns * 300) + 120
    height = (columns * 96 if vertical else rows * 74) + 150
    box_w, box_h, pad_x, pad_y = 236, 52, 60, 64
    nodes, links = [], []
    for task in tasks:
        column, row = positions[task["id"]]
        x = pad_x + (row * 280 if vertical else column * 300)
        y = pad_y + (column * 96 if vertical else row * 74)
        colour = STATUS_COLOURS.get(task.get("status"), "#6b7280")
        claim = (task.get("claim") or {}).get("agent")
        subtitle = task.get("status", "")
        if claim:
            subtitle += f" · {claim.split('/')[-1]}"
        elif task.get("blocked_needs") == "human":
            subtitle += " · needs owner"
        title = (task.get("title") or "")[:38]
        nodes.append(
            f'<g class="node"><rect x="{x}" y="{y}" width="{box_w}" height="{box_h}" rx="7" '
            f'fill="#111827" stroke="{colour}" stroke-width="2"/>'
            f'<rect x="{x}" y="{y}" width="4" height="{box_h}" rx="2" fill="{colour}"/>'
            f'<text x="{x + 14}" y="{y + 20}" fill="#e5e7eb" font-size="12.5" '
            f'font-family="ui-monospace, monospace">{task["id"]}</text>'
            f'<text x="{x + 14}" y="{y + 36}" fill="#9ca3af" font-size="10.5" '
            f'font-family="ui-sans-serif, system-ui">{_esc(title)}</text>'
            f'<text x="{x + box_w - 12}" y="{y + 20}" fill="{colour}" font-size="10" '
            f'text-anchor="end" font-family="ui-sans-serif, system-ui">{subtitle}</text></g>')
    for task in tasks:
        column, row = positions[task["id"]]
        for dep in edges.get(task["id"], []):
            if dep not in positions:
                continue
            dcol, drow = positions[dep]
            if vertical:
                sx = pad_x + row * 280 + box_w / 2
                sy = pad_y + column * 96
                ex = pad_x + drow * 280 + box_w / 2
                ey = pad_y + dcol * 96 + box_h
                mid = (sy + ey) / 2
                path = (f"M {ex} {ey} C {ex} {mid}, {sx} {mid}, {sx} {sy}")
            else:
                sx = pad_x + column * 300
                sy = pad_y + row * 74 + box_h / 2
                ex = pad_x + dcol * 300 + box_w
                ey = pad_y + drow * 74 + box_h / 2
                mid = (sx + ex) / 2
                path = f"M {ex} {ey} C {mid} {ey}, {mid} {sy}, {sx} {sy}"
            links.append(f'<path d="{path}" fill="none" stroke="#374151" stroke-width="1.4"/>')
    legend = " ".join(
        f'<span style="color:{colour}">■</span> {status}'
        for status, colour in sorted(STATUS_COLOURS.items())
        if status in {task.get("status") for task in tasks})
    blocked = [task for task in tasks if task.get("status") == "blocked"]
    return f"""<!doctype html>
