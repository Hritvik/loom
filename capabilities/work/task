def cmd_claim(args, store: Store) -> int:
    agent = require_agent(args)
    now = parse_now(args.now)
    ttl = parse_duration(args.ttl)
    registry = store.load()
    task = find_task(registry, args.task)
    require_revision(task, args.revision)
    existing = task.get("claim")
    if existing:
        expiry = lease_expiry(task)
        if expiry and expiry > now:
            raise WorkError(
                f"{task['id']} is leased by {existing.get('agent')} until {iso(expiry)}; "
                "renew or takeover after expiry"
            )
        raise WorkError(
            f"{task['id']} has an expired lease held by {existing.get('agent')}; use takeover with a reason"
        )
    require_state(task, CLAIMABLE_FROM, "claim")
    satisfied, unmet = dependencies_met(registry, task)
    if not satisfied:
        raise WorkError(f"cannot claim {task['id']}: unmet dependencies {', '.join(unmet)}")
    conflicts = write_path_conflicts(registry, task, now)
    if conflicts:
        raise WorkError("write-path conflict: " + "; ".join(conflicts))
    task["claim"] = {
        "agent": agent,
        "base_revision": args.revision,
        "lease_expires": iso(now + ttl),
        "heartbeat": iso(now),
    }
    bump(task, "claimed", now)
    store.save()
    store.append_event(event="claim", task=task["id"], agent=agent, status="claimed",
                       revision=task["revision"], lease_expires=task["claim"]["lease_expires"],
                       base_revision=args.revision, now=args.now)
    print(f"claimed {task['id']} at revision {task['revision']} until {task['claim']['lease_expires']}")
    return 0


def cmd_renew(args, store: Store) -> int:
    agent = require_agent(args)
    now = parse_now(args.now)
    ttl = parse_duration(args.ttl)
    registry = store.load()
    task = find_task(registry, args.task)
    require_revision(task, args.revision)
    require_state(task, ACTIVE_STATES, "renew")
    require_owner(task, agent)
    expiry = lease_expiry(task)
    if expiry is None:
        raise WorkError(f"{task['id']} has no lease to renew")
    if expiry <= now:
        raise WorkError(
            f"lease on {task['id']} expired at {iso(expiry)}; renewal is no longer safe, use takeover"
        )
    task["claim"]["lease_expires"] = iso(now + ttl)
    task["claim"]["heartbeat"] = iso(now)
    bump(task, task["status"], now)
    store.save()
    store.append_event(event="renew", task=task["id"], agent=agent, status=task["status"],
                       revision=task["revision"], lease_expires=task["claim"]["lease_expires"],
                       now=args.now)
    print(f"renewed {task['id']} at revision {task['revision']} until {task['claim']['lease_expires']}")
    return 0


def cmd_release(args, store: Store) -> int:
    agent = require_agent(args)
    now = parse_now(args.now)
    registry = store.load()
    task = find_task(registry, args.task)
    require_revision(task, args.revision)
    require_state(task, ACTIVE_STATES | {"in-progress"}, "release")
    require_owner(task, agent)
    previous = task.get("claim") or {}
    task["claim"] = None
    bump(task, "ready", now)
    store.save()
    store.append_event(event="release", task=task["id"], agent=agent, status="ready",
                       revision=task["revision"], previous_agent=previous.get("agent"),
                       reason=args.reason, now=args.now)
    print(f"released {task['id']} back to ready at revision {task['revision']}")
    return 0


def cmd_takeover(args, store: Store) -> int:
    agent = require_agent(args)
    now = parse_now(args.now)
    ttl = parse_duration(args.ttl)
    registry = store.load()
    task = find_task(registry, args.task)
    require_revision(task, args.revision)
    require_state(task, ACTIVE_STATES, "take over")
    existing = task.get("claim")
    if not existing:
        raise WorkError(f"{task['id']} has no claim to take over; use claim")
    expiry = lease_expiry(task)
    if expiry and expiry > now:
        raise WorkError(
            f"lease on {task['id']} is still live until {iso(expiry)}; takeover requires expiry"
        )
    previous_agent = existing.get("agent")
    task["claim"] = {
        "agent": agent,
        "base_revision": args.revision,
        "lease_expires": iso(now + ttl),
        "heartbeat": iso(now),
    }
    bump(task, "claimed", now)
    store.save()
    store.append_event(event="takeover", task=task["id"], agent=agent, status="claimed",
                       revision=task["revision"], lease_expires=task["claim"]["lease_expires"],
                       previous_agent=previous_agent, reason=args.reason, now=args.now)
    print(
        f"took over {task['id']} from {previous_agent} at revision {task['revision']} "
        f"until {task['claim']['lease_expires']}"
    )
    return 0


def git_review_check(task: dict, *args: str) -> subprocess.CompletedProcess:
    repo = Path(task["owner_repo"]).expanduser()
    try:
        return subprocess.run(
            ["git", "--no-replace-objects", "--literal-pathspecs", "-C", str(repo), *args],
            capture_output=True, text=True, errors="surrogateescape", timeout=10, check=False,
            env={key: value for key, value in os.environ.items() if not key.startswith("GIT_")},
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise WorkError(f"{task['id']}: could not verify the owner repository with Git") from exc


def require_source_commit(task: dict, source: str) -> None:
    if not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", source):
        raise WorkError("review source must be a full Git commit hash")
    root = git_review_check(task, "rev-parse", "--show-toplevel")
    if root.returncode or Path(root.stdout.strip()).resolve() != Path(task["owner_repo"]).expanduser().resolve():
        raise WorkError(f"{task['id']}: owner path must be a Git checkout root")
    result = git_review_check(task, "cat-file", "-t", source)
    if result.returncode or result.stdout.strip() != "commit":
        raise WorkError(f"{task['id']}: source commit is missing from the owner repository")


def review_base(task: dict, source: str, base: str | None) -> str | None:
    if base is None:
        ancestry = git_review_check(task, "rev-list", "--parents", "-n", "1", source)
        if ancestry.returncode or not ancestry.stdout.strip():
            raise WorkError("could not determine the first parent of the review source")
        return next(iter(ancestry.stdout.split()[1:]), None)
    require_source_commit(task, base)
    if base == source or git_review_check(task, "merge-base", "--is-ancestor", base, source).returncode:
        raise WorkError("review base must be an ancestor distinct from the source commit")
    return base


def task_history(store: Store, task: dict) -> list[dict]:
    return [event for _, event in store.read_events() if event.get("task") == task["id"]]


def require_independent(task: dict, reviewer: str, history: list[dict]) -> None:
    implementers = {
        event.get("agent") for event in history
        if event.get("event") in {"claim", "renew", "takeover"}
        or (event.get("event") == "transition" and event.get("status") == "green")
    }
    if reviewer == claim_owner(task) or reviewer in implementers:
        raise WorkError(f"review must be independent; {reviewer!r} implemented or held a claim on {task['id']}")


def latest_review_request(task: dict, history: list[dict]) -> dict:
    return next((
        event for event in reversed(history)
        if event.get("event") == "ask" and event.get("review_source")
        and event.get("revision") == task["revision"] and event.get("status") == "green"
    ), {})


def verified_review(args, store: Store, task: dict) -> dict:
    if not args.reviewer or args.decision != "approve":
        raise WorkError("transition to reviewed requires --reviewer and --decision approve")
    if args.reviewer == require_agent(args):
        raise WorkError("review must be independent; the acting agent cannot name itself as reviewer")
    history = task_history(store, task)
    require_independent(task, args.reviewer, history)
    if not args.review_answer:
        raise WorkError("transition to reviewed requires --review-answer from the reviewer inbox")
    request = latest_review_request(task, history)
    answer = next((event for event in history if event.get("seq") == args.review_answer), {})
    if (not request or answer.get("event") != "answer" or answer.get("decision") != "approve"
            or answer.get("in_reply_to") != request["seq"] or request.get("to") != args.reviewer
            or answer.get("agent") != args.reviewer or answer.get("revision") != task["revision"]
            or answer.get("status") != "green"
            or any(answer.get(key) != request[key] for key in ("review_source", "review_base", "review_evidence"))
            or not (answer.get("note") or "").strip()):
        raise WorkError("approval must match the reviewer, current green revision and latest review request")
    if args.evidence and args.evidence != request["review_evidence"]:
        raise WorkError("review evidence must match the submitted evidence path")
    require_source_commit(task, request["review_source"])
    return {
        "reviewer": args.reviewer,
        "decision": "approve",
        "source": request["review_source"],
        "base": request["review_base"],
        "evidence": request["review_evidence"],
        "answer": args.review_answer,
        **({"severity": args.severity} if args.severity else {}),
    }


def require_source_on_ref(task: dict, source: str, ref: str) -> str:
    """Require a real commit that is in the history of the integration branch."""
    require_source_commit(task, source)
    if not ref.startswith("refs/heads/") or git_review_check(task, "check-ref-format", ref).returncode:
        raise WorkError("integration_ref must name a local branch under refs/heads/")
    tip = git_review_check(task, "rev-parse", "--verify", "--end-of-options", ref + "^{commit}")
    if tip.returncode:
        raise WorkError(f"configured integration branch {ref} is missing from the owner repository")
    integration_tip = tip.stdout.strip()
    if git_review_check(task, "merge-base", "--is-ancestor", source, integration_tip).returncode:
        raise WorkError(f"commit must be in the history of {ref}")
    return integration_tip


def require_reviewed_source(task: dict, source: str | None, ref: str) -> str:
    review = task.get("review") or {}
    if not review.get("source") or not review.get("answer"):
        raise WorkError("missing verified review receipt; reopen the task and submit it for review")
    if source != review["source"]:
        raise WorkError("--integrated-source must be the exact approved commit")
    integration_tip = require_source_on_ref(task, source, ref)
    base = review.get("base")
    if base:
        changed = git_review_check(task, "diff", "--name-only", "-z", "--no-renames", base, source)
    else:
        changed = git_review_check(
            task, "diff-tree", "--root", "--no-commit-id", "--name-only", "-r", "-z", "--no-renames", source,
        )
    if changed.returncode:
        raise WorkError("could not determine the paths changed by the approved commit")
    paths = list(dict.fromkeys(changed.stdout.split("\0")[:-1]))
    if paths and git_review_check(
        task, "diff", "--quiet", "--no-ext-diff", "--ignore-submodules=none", source, integration_tip, "--", *paths,
    ).returncode:
        raise WorkError(f"paths changed by the approved commit differ in {ref}; submit the integrated change for review")
    return integration_tip


def cmd_transition(args, store: Store) -> int:
    agent = require_agent(args)
    now = parse_now(args.now)
    registry = store.load()
    task = find_task(registry, args.task)
    require_revision(task, args.revision)
    current = task.get("status")
    target = args.to
    if target == "claimed":
        raise WorkError("use `claim` to take a lease; `transition` cannot create claims")
    allowed = TRANSITIONS.get(current)
    if allowed is None:
        raise WorkError(f"unknown current state {current!r}")
    if target not in allowed:
        raise WorkError(
            f"illegal transition {current} -> {target} for {task['id']}; "
            f"allowed: {', '.join(sorted(allowed)) or '(none)'}"
        )

    owner = claim_owner(task)
    # Independent review is the one transition a non-owner may perform.
    if (current in ACTIVE_STATES | {"in-progress"} and owner and owner != agent
            and target != "reviewed"):
        raise WorkError(f"{task['id']} is claimed by {owner!r}; {agent!r} cannot move it")

    if target in {"green", "blocked", "red"} and current in ACTIVE_STATES:
        require_owner(task, agent)

    review = verified_review(args, store, task) if target == "reviewed" else None
    if target == "rejected" and not args.reason:
        raise WorkError("transition to rejected requires --reason")
    if target in {"released", "blocked"} and not args.reason:
        raise WorkError(f"transition to {target} requires --reason")
    if target == "ready" and current == "reviewed" and not args.reason:
        raise WorkError("reopening a reviewed task requires --reason")
    if target == "ready" and current in ACTIVE_STATES and not args.reason:
        raise WorkError("returning claimed work to ready requires --reason (or use `release`)")
    if target in {"integrated", "accepted"} and not args.evidence:
        raise WorkError(f"transition to {target} requires --evidence")
    integration_tip = None
    if target in {"integrated", "accepted"}:
        satisfied, unmet = dependencies_met(registry, task)
        if not satisfied:
            raise WorkError(f"cannot mark {task['id']} {target}: unmet dependencies {', '.join(unmet)}")
    if target == "integrated" or (target == "accepted" and current == "reviewed"):
        board = find_board(registry, task["board"])
        integration_tip = require_reviewed_source(
            task, args.integrated_source, board.get("integration_ref", "refs/heads/main"),
        )

    if args.evidence:
        task["evidence"] = args.evidence
    if review:
        task["evidence"] = review["evidence"]
        task["review"] = review
        task["claim"] = None
    if current == "reviewed" and target == "ready":
        task.pop("review", None)
    if target in {"integrated", "accepted", "released", "rejected", "blocked"}:
        # A blocked packet is waiting on someone else; holding a lease is meaningless and
        # the validator rejects a claim on a blocked task.
        task["claim"] = None
    if target == "ready":
        task["claim"] = None
    if target == "blocked":
        task["blocked_needs"] = args.needs or "agent"
    elif current == "blocked":
        task.pop("blocked_needs", None)
    bump(task, target, now)
    store.save()
    store.append_event(event="transition", task=task["id"], agent=agent, status=target,
                       previous_status=current, revision=task["revision"],
                       evidence=args.evidence, reviewer=args.reviewer,
                       decision=args.decision, reason=args.reason, now=args.now,
                       **({"review_answer": review["answer"], "review_source": review["source"]} if review else {}),
                       **({"integrated_source": args.integrated_source, "integration_tip": integration_tip}
                          if integration_tip else {}))
    print(f"{task['id']}: {current} -> {target} at revision {task['revision']}")
    return 0


def integration_receipt(history: list[dict]) -> dict:
    """The latest integration proof recorded for a task, if any."""
    for event in reversed(history):
        if event.get("event") == "annotate" and event.get("integrated_source"):
            return event
        if (event.get("event") == "transition" and event.get("status") == "integrated"
                and event.get("integrated_source")):
            return event
    return {}


def cmd_annotate(args, store: Store) -> int:
    """Record an integration receipt for a task that was integrated before receipts existed.

    The proof lives in the event log, exactly like a normal integration. Nothing is
    inferred: the caller supplies a commit that must exist and be in the history of
    the board's integration branch.
    """
    agent = require_agent(args)
    registry = store.load()
    task = find_task(registry, args.task)
    require_revision(task, args.revision)
    if task.get("status") not in {"integrated", "accepted"}:
        raise WorkError(
            f"only an integrated or accepted task can be annotated; {task['id']} is {task['status']!r}")
    if not args.reason:
        raise WorkError("annotate requires --reason explaining how the commit was established")
    history = task_history(store, task)
    if integration_receipt(history):
        raise WorkError(f"{task['id']} already records an integration receipt; history is not rewritten")
    board = find_board(registry, task["board"])
    ref = board.get("integration_ref", "refs/heads/main")
    integration_tip = require_source_on_ref(task, args.integrated_source, ref)
    if args.base:
        base = review_base(task, args.integrated_source, args.base)
        changed = git_review_check(
            task, "diff", "--name-only", "-z", "--no-renames", base, args.integrated_source)
        if changed.returncode:
            raise WorkError("could not determine the paths changed since --base")
        paths = list(dict.fromkeys(changed.stdout.split("\0")[:-1]))
        if paths and git_review_check(
            task, "diff", "--quiet", "--no-ext-diff", "--ignore-submodules=none",
            args.integrated_source, integration_tip, "--", *paths,
        ).returncode:
            raise WorkError(f"paths changed since --base differ in {ref}")
    bump(task, task["status"], parse_now(args.now))
    store.save()
    store.append_event(event="annotate", task=task["id"], agent=agent, status=task["status"],
                       revision=task["revision"], integrated_source=args.integrated_source,
                       integration_tip=integration_tip, base=args.base or None,
                       path_check="verified" if args.base else "skipped",
                       reason=args.reason, now=args.now)
    print(f"{task['id']}: integration receipt {args.integrated_source[:12]} at revision {task['revision']}")
    return 0


def cmd_events(args, store: Store) -> int:
    records = store.read_events()
    if args.task:
        records = [(raw, rec) for raw, rec in records if rec.get("task") == args.task]
    if args.limit:
        records = records[-args.limit:]
    errors = []
    if args.verify:
        records_all = store.read_events()
        errors = verify_event_chain(records_all)
        if store.has_registry():
            errors.extend(verify_registry_events(store.load(), records_all))
    for raw, record in records:
        if args.json:
            print(raw.decode("utf-8"))
        else:
            extra = record.get("reason") or record.get("evidence") or ""
            if record.get("event") == "ask":
                extra = f"to {record.get('to')}: {record.get('question')}"
            elif record.get("event") == "answer":
                extra = f"re {record.get('in_reply_to')}: {record.get('decision')}"
            print(
                f"{record.get('seq'):>4} {record.get('ts')} {record.get('event'):<10} "
                f"{record.get('task', '-'):<22} r{record.get('revision', '-')} "
                f"{record.get('status', ''):<10} {record.get('agent', '')} {extra}"
            )
    if args.verify:
        for error in errors:
            print(f"ERROR {error}")
        print("event chain OK" if not errors else f"event chain FAIL ({len(errors)} errors)")
        return 0 if not errors else 1
    return 0


def _message_records(store: Store) -> list[dict]:
    return [record for _, record in store.read_events()]


def cmd_ask(args, store: Store) -> int:
    """Ask a question about a task on the audit log. Non-mutating: revision and status are copied."""
    agent = require_agent(args)
    if not args.to or not args.question.strip():
        raise WorkError("ask requires --to and a non-empty --question")
    if args.to == agent:
        raise WorkError("an agent cannot ask itself; address another agent or the owner")
    registry = store.load()
    task = find_task(registry, args.task)
    submission = {}
    if args.review_source:
        require_state(task, {"green"}, "submit for review")
        history = task_history(store, task)
        require_independent(task, args.to, history)
        last_green = max((
            event["seq"] for event in history
            if event.get("event") == "transition" and event.get("status") == "green"
        ), default=0)
        if any(
            event.get("event") == "answer" and event.get("review_source")
            and event.get("decision") == "changes requested"
            and (event["seq"] > last_green or event["review_source"] == args.review_source)
            for event in history
        ):
            raise WorkError("changes were requested; submit a new commit after a new green transition")
        require_source_commit(task, args.review_source)
        evidence = (args.review_evidence or task.get("evidence") or "").strip()
        if not evidence or len(evidence) > 512:
            raise WorkError("review submission requires an evidence locator of 1–512 characters")
        submission = {
            "review_source": args.review_source,
            "review_base": review_base(task, args.review_source, args.review_base),
            "review_evidence": evidence,
        }
    elif args.review_base is not None or args.review_evidence is not None:
        raise WorkError("--review-base and --review-evidence require --review-source")
    event = store.append_event(
        event="ask", task=task["id"], agent=agent, to=args.to, question=args.question.strip(),
        needed_by=args.needed_by, revision=task.get("revision", 0), status=task.get("status"),
        now=args.now, **submission)
    print(f"asked {args.to} about {task['id']} (event {event['seq']})")
    return 0


def cmd_answer(args, store: Store) -> int:
    """Answer a question event. Only the addressee may answer, and only once."""
    agent = require_agent(args)
    registry = store.load()
    task = find_task(registry, args.task)
    records = _message_records(store)
    question = next((record for record in records if record.get("seq") == args.question), None)
    if question is None or question.get("event") != "ask":
        raise WorkError(f"event {args.question} is not a question")
    if question.get("task") != task["id"]:
        raise WorkError(
            f"event {args.question} asks about {question.get('task')}, not {task['id']}")
    if question.get("to") != agent:
        raise WorkError(
            f"event {args.question} is addressed to {question.get('to')}, not {agent}")
    if any(record.get("event") == "answer" and record.get("in_reply_to") == args.question
           for record in records):
        raise WorkError(f"event {args.question} is already answered")
    source = question.get("review_source")
    if source:
        require_state(task, {"green"}, "answer review")
        history = task_history(store, task)
        require_independent(task, agent, history)
        if question != latest_review_request(task, history):
            raise WorkError("review request was superseded or is for an earlier green revision")
        if args.decision not in {"approve", "changes requested"} or not (args.note or "").strip():
            raise WorkError("review answer requires approve or changes requested and a nonblank note")
    event = store.append_event(
        event="answer", task=task["id"], agent=agent, to=question.get("agent"),
        in_reply_to=args.question, decision=args.decision, note=args.note,
        revision=task.get("revision", 0), status=task.get("status"), now=args.now,
        **({key: question[key] for key in ("review_source", "review_base", "review_evidence")} if source else {}))
    print(f"answered {question.get('agent')} on {task['id']} (event {event['seq']})")
    return 0


ROLE_BY_KIND = {"review": "reviewer", "integration": "integrator"}
ROLES = ("implementer", "reviewer", "integrator")
OWNER_DEFAULT = "owner"


def task_role(task: dict) -> str:
    """The hat this work needs. Advanced by state once the role field lands."""
    return ROLE_BY_KIND.get(task.get("kind"), "implementer")


def cmd_decisions(args, store: Store) -> int:
    """Everything that needs the owner: authority decisions and questions addressed to them."""
    registry = store.load()
    owner = args.owner or os.environ.get("WORK_OWNER") or OWNER_DEFAULT
    index = dependents_index(registry)
    blocked = []
    reasons = {}
    for _, record in store.read_events():
        if record.get("event") == "transition" and record.get("status") == "blocked":
            reasons[record.get("task")] = record.get("reason") or ""
    for task in registry["tasks"]:
        if task.get("status") != "blocked":
            continue
        if (task.get("blocked_needs") or "agent") != "human":
            continue
        blocked.append({
            "task": task["id"],
            "title": task.get("title"),
            "revision": task.get("revision", 0),
            "reason": reasons.get(task["id"], ""),
            "unblocks": transitive_dependents(index, task["id"]),
        })
    records = _message_records(store)
    answered = {record.get("in_reply_to") for record in records if record.get("event") == "answer"}
    questions = [
        {
            "task": record.get("task"),
            "from": record.get("agent"),
            "seq": record.get("seq"),
            "question": record.get("question"),
            "neededBy": record.get("needed_by"),
        }
        for record in records
        if record.get("event") == "ask" and record.get("to") == owner
        and record.get("seq") not in answered
    ]
    if args.json:
        print(json.dumps({"owner": owner, "decisions": blocked, "questions": questions}, indent=2))
        return 0
    if not blocked and not questions:
        print(f"nothing needs {owner}")
        return 0
    print(f"Decision queue for {owner}: {len(blocked)} decision(s), {len(questions)} question(s)\n")
    for number, item in enumerate(blocked, start=1):
        print(f"{number}. {item['task']}  blocked  r{item['revision']}  {item['title'] or ''}")
        if item["reason"]:
            print(f"   why: {item['reason']}")
        if item["unblocks"]:
            print(f"   unblocks: {', '.join(item['unblocks'])}")
    for number, item in enumerate(questions, start=len(blocked) + 1):
        needed = f"  needed by {item['neededBy']}" if item["neededBy"] else ""
        print(f"{number}. question on {item['task']} from {item['from']}{needed}")
        print(f"   {item['question']}")
        print(f"   answer: ./task answer {item['task']} --question {item['seq']} --decision ...")
    return 0


def cmd_tick(args, store: Store) -> int:
    """One policy pass: what would be claimed and launched, and what is stale."""
    registry = store.load()
    now = parse_now(args.now)
    index = dependents_index(registry)
    limits = {
        "implementer": args.max_implementer,
        "reviewer": args.max_reviewer,
        "integrator": args.max_integrator,
    }
    active = {role: 0 for role in ROLES}
    expired = []
    for task in registry["tasks"]:
        claim = task.get("claim") or {}
        if not claim:
            continue
        expiry = lease_expiry(task)
        if expiry and expiry > now:
            active[task_role(task)] += 1
        else:
            expired.append({
                "task": task["id"],
                "agent": claim.get("agent"),
                "expired": claim.get("lease_expires"),
            })
    candidates = []
    for task in registry["tasks"]:
        if task.get("status") not in CLAIMABLE_FROM:
            continue
        satisfied, unmet = dependencies_met(registry, task)
        if not satisfied:
            continue
        if write_path_conflicts(registry, task, now):
            continue
        candidates.append({
            "task": task["id"],
            "role": task_role(task),
            "title": task.get("title"),
            "revision": task.get("revision", 0),
            "unblocks": len(transitive_dependents(index, task["id"])),
        })
    candidates.sort(key=lambda item: (-item["unblocks"], item["task"]))
    slots = {role: limits[role] - active[role] for role in ROLES}
    chosen, held = [], []
    for item in candidates:
        if slots[item["role"]] > 0:
            slots[item["role"]] -= 1
            chosen.append(item)
        else:
            held.append({**item, "reason": f"no {item['role']} slot (limit {limits[item['role']]})"})
    if args.json:
        print(json.dumps({"active": active, "limits": limits, "chosen": chosen,
                          "held": held, "expired": expired}, indent=2))
        return 0
    print(f"Tick preview — {iso(now)}")
    print("  capacity: " + "  ".join(
        f"{role} {active[role]}/{limits[role]}" for role in ROLES))
    print()
    if chosen:
        print("Would claim and launch:")
        for item in chosen:
            print(f"  {item['task']:<22} {item['role']:<12} r{item['revision']:<3}"
                  f" +{item['unblocks']} downstream  {item['title'] or ''}")
    else:
        print("Would claim and launch: nothing")
    if held:
        print("\nHeld back:")
        grouped: dict[str, list[dict]] = {}
        for item in held:
            grouped.setdefault(item["reason"], []).append(item)
        for reason, items in sorted(grouped.items()):
            shown = ", ".join(entry["task"] for entry in items[:4])
            more = f" (+{len(items) - 4} more)" if len(items) > 4 else ""
            print(f"  {reason}: {shown}{more}")
    if expired:
        print("\nExpired leases to release or take over:")
        for item in expired:
            print(f"  {item['task']:<22} {item['agent']}  expired {item['expired']}")
    print("\nPreview only. Nothing was claimed; wiring --apply needs a worker that consumes launches.")
    return 0


def cmd_inbox(args, store: Store) -> int:
    """List questions addressed to an agent that have no answer yet."""
    agent = args.agent or os.environ.get("WORK_AGENT")
    if not agent:
        raise WorkError("inbox requires --agent or WORK_AGENT")
    records = _message_records(store)
    answered = {record.get("in_reply_to") for record in records if record.get("event") == "answer"}
    questions = [
        record for record in records
        if record.get("event") == "ask" and record.get("to") == agent
        and (args.all or record.get("seq") not in answered)
    ]
    if args.task:
        questions = [record for record in questions if record.get("task") == args.task]
    if not args.all and any(record.get("review_source") for record in questions):
        tasks = {task["id"]: task for task in store.load()["tasks"]}
        latest = {}
        for record in records:
            if record.get("event") == "ask" and record.get("review_source"):
                latest[(record["task"], record["revision"])] = record["seq"]
        questions = [
            record for record in questions
            if not record.get("review_source")
            or (tasks[record["task"]]["status"] == "green"
                and tasks[record["task"]]["revision"] == record["revision"]
                and latest[(record["task"], record["revision"])] == record["seq"])
        ]
    if args.json:
        print(json.dumps([
            {"seq": record.get("seq"), "ts": record.get("ts"), "task": record.get("task"),
             "from": record.get("agent"), "question": record.get("question"),
             "neededBy": record.get("needed_by"),
             "answered": record.get("seq") in answered,
             **({"reviewSource": record["review_source"], "reviewBase": record["review_base"],
                 "reviewEvidence": record["review_evidence"], "revision": record["revision"]}
                if record.get("review_source") else {})}
            for record in questions
        ], indent=2))
        return 0
    if not questions:
        print(f"inbox empty for {agent}")
        return 0
    for record in questions:
        state = "answered" if record.get("seq") in answered else "open"
        needed = f" needed-by {record['needed_by']}" if record.get("needed_by") else ""
        source = ""
        if record.get("review_source"):
            source = (f" review r{record['revision']} {record['review_source']}"
                      f" base={record['review_base'] or '(root)'} evidence={record['review_evidence']}")
        print(f"{record.get('seq'):>4} {record.get('ts')} {state:<8} {record.get('task')} "
              f"from {record.get('agent')}{needed}{source}: {record.get('question')}")
    return 0


def cmd_migrate(args, store: Store) -> int:
    """Copy a file work home into a SQLite database, verifying the chain on the way."""
    source_root = Path(args.source or args.root).expanduser()
    source = FileStore(source_root)
    registry = source.load()
    records = source.read_events()
    problems = verify_event_chain(records)
    if problems:
        for problem in problems:
            print(f"ERROR {problem}", file=sys.stderr)
        raise WorkError("source event chain does not verify; refusing to migrate")

    target_path = Path(args.to).expanduser()
    target = SqliteStore(source_root, target_path)
    try:
        existing = target.connection.execute("SELECT count(*) FROM events").fetchone()[0]
        if existing and not args.force:
            raise WorkError(f"{target_path} already holds {existing} events; pass --force to replace")
        if args.force:
            with target._transaction():
                target.connection.execute("DELETE FROM events")
        target.registry = registry
        target.save()
        for raw, record in records:
            target.connection.execute(
                "INSERT INTO events (seq, task, body, prev, hash) VALUES (?, ?, ?, ?, ?)",
                (record["seq"], record.get("task"), raw.decode("utf-8"), record["prev"],
                 hashlib.sha256(raw).hexdigest()))
    finally:
        target.close()

    check = SqliteStore(source_root, target_path)
    try:
        copied = check.load()
        copied_events = check.read_events()
        problems = verify_event_chain(copied_events)
    finally:
        check.close()
    if problems:
        for problem in problems:
            print(f"ERROR {problem}", file=sys.stderr)
        raise WorkError("migrated event chain does not verify")
    print(f"migrated {len(copied['tasks'])} tasks, {len(copied['edges'])} edges, "
          f"{len(copied_events)} events to {target_path}")
    print("verify with: ./task --store sqlite --db " + str(target_path) + " list --ready")
    return 0


def cmd_export(args, store: Store) -> int:
    """Render the store as YAML or JSON, the replacement for diffable state in git."""
    registry = store.load()
    if args.format == "json":
        text = json.dumps(registry, indent=2, default=str) + "\n"
    else:
        text = REGISTRY_HEADER + yaml.safe_dump(
            registry, sort_keys=False, default_flow_style=False, allow_unicode=True, width=100)
    if args.out:
        out = Path(args.out).expanduser()
        out.write_text(text, encoding="utf-8")
        print(f"wrote {out} ({len(text.splitlines())} lines)")
    else:
        print(text, end="" if text.endswith("\n") else "\n")
    return 0


def cmd_genesis(args, store: Store) -> int:
    agent = require_agent(args)
    if store.read_events():
        raise WorkError("event log is not empty; genesis is written once")
    registry = store.load() if store.has_registry() else {}
    digest = hashlib.sha256(store.export_bytes()).hexdigest() if store.has_registry() else ""
    event = store.append_event(event="genesis", agent=agent, registry_sha256=digest,
                               tasks=len(registry.get("tasks", [])), now=args.now)
    print(f"genesis event {event['seq']} written (sha256 {digest[:12]}…)")
    return 0


def cmd_board(args, store: Store) -> int:
    registry = store.load()
    if args.action == "list":
        for board in registry["boards"]:
            count = sum(1 for task in registry["tasks"] if task["board"] == board["id"])
            print(f"{board['id']:<16} {board['kind']:<8} {count:>2} tasks  {board['repo']}/{board['path']}")
        return 0
    if args.action == "add":
        return add_board(args, store, registry)
    if args.action == "remove":
        return remove_board(args, store, registry)
    board = find_board(registry, args.board)
    if args.action == "import":
        return import_board(args, store, board, registry)
    if args.action == "titles":
        return backfill_titles(args, store, board, registry)
    if board["kind"] != "board":
        raise WorkError(f"{board['id']} is a {board['kind']} board; only packet boards are materialised")
    path = Path(board["repo"]).expanduser() / board["path"]
    if not path.is_file():
        raise WorkError(f"board file missing: {path}")
    data = json.loads(path.read_text(encoding="utf-8"))
    packets = data.setdefault("packets", [])
    by_id = {packet["id"]: packet for packet in packets}
    now = parse_now(args.now)
    central = {task["id"].split("/", 1)[-1]: task for task in registry["tasks"]
               if task["board"] == board["id"]}
    changes: list[str] = []
    unregistered = sorted(set(by_id) - set(central))

    for suffix, task in central.items():
        expected = {
            "task": task["id"],
            "revision": task.get("revision", 0),
            "status": task.get("status"),
            "claim": task.get("claim"),
        }
        packet = by_id.get(suffix)
        if packet is None:
            changes.append(f"create packet {suffix} ({task.get('status')})")
            if args.check:
                continue
            packet = new_packet(suffix, task, data)
            packets.append(packet)
            by_id[suffix] = packet
        current = packet.get("central") or {}
        if {key: current.get(key) for key in expected} != expected:
            changes.append(f"update central block on {suffix} (r{expected['revision']} {expected['status']})")
            if not args.check:
                packet["central"] = {**expected, "synced_at": iso(now)}
        if packet.get("status") != expected["status"]:
            if int(task.get("revision", 0)) == 0 and task.get("status_source") == "board":
                changes.append(
                    f"report status drift on {suffix} (board {packet.get('status')} vs central "
                    f"{expected['status']}); run reconcile")
            else:
                changes.append(
                    f"update status on {suffix} ({packet.get('status')} -> {expected['status']})")
                if not args.check:
                    packet["status"] = expected["status"]

    for suffix in unregistered:
        changes.append(f"keep unregistered packet {suffix} (report only)")

    if not changes:
        print(f"{board['id']}: in sync ({len(central)} tasks)")
        return 0
    for change in changes:
        print(("would " if args.check else "") + change)
    if args.check:
        return 1
    data["central_registry"] = {
        "home": "capabilities/work",
        "board": board["id"],
        "synced_at": iso(now),
    }
    atomic_json_write(path, data)
    print(f"{board['id']}: wrote {path}")
    return 0


def program_headings(path: Path) -> dict[str, str]:
    """Map `## W-8 — Title` headings to their titles."""
    titles: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.startswith("## ") and " — " in line:
            suffix, title = line[3:].split(" — ", 1)
            titles[suffix.strip()] = title.strip()
    return titles


def add_board(args, store: Store, registry: dict) -> int:
    """Register a board. Configuration, but recorded as an event like every other mutation."""
    agent = require_agent(args)
    if not args.board:
        raise WorkError("board add requires --board")
    if not BOARD_PATTERN.match(args.board):
        raise WorkError(f"invalid board id {args.board!r}")
    if any(entry["id"] == args.board for entry in registry["boards"]):
        raise WorkError(f"board {args.board} already exists")
    repo = Path(args.repo or ".").expanduser()
    entry = {
        "id": args.board,
        "kind": args.kind,
        "role": args.role,
        "repo": str(repo),
        "path": args.path or "",
    }
    if args.path and not (repo / args.path).is_file():
        raise WorkError(f"board file missing: {repo / args.path}")
    if args.integration_ref:
        entry["integration_ref"] = args.integration_ref
    registry["boards"].append(entry)
    store.save()
    store.append_event(event="board", agent=agent, action="add", board=args.board,
                       kind=args.kind, path=entry["path"], now=args.now)
    print(f"added board {args.board} ({args.kind}) at {entry['repo']}/{entry['path']}")
    return 0


def remove_board(args, store: Store, registry: dict) -> int:
    agent = require_agent(args)
    if not args.board:
        raise WorkError("board remove requires --board")
    entry = next((item for item in registry["boards"] if item["id"] == args.board), None)
    if entry is None:
        raise WorkError(f"unknown board {args.board}")
    if any(task.get("board") == args.board for task in registry["tasks"]):
        raise WorkError(f"board {args.board} still has tasks; move or delete them first")
    registry["boards"].remove(entry)
    store.save()
    store.append_event(event="board", agent=agent, action="remove", board=args.board, now=args.now)
    print(f"removed board {args.board}")
    return 0


def backfill_titles(args, store: Store, board: dict, registry: dict) -> int:
    """Adopt program-board headings as titles for tasks that were registered without one."""
    if board["kind"] != "program":
        raise WorkError(f"{board['id']} is a {board['kind']} board; titles apply to program boards")
    path = Path(board["repo"]).expanduser() / board["path"]
    if not path.is_file():
        raise WorkError(f"board file missing: {path}")
    headings = program_headings(path)
    now = parse_now(args.now)
    changes: list[str] = []
    for task in registry["tasks"]:
        if task.get("board") != board["id"]:
            continue
        suffix = task["id"].split("/", 1)[-1]
        title = headings.get(suffix)
        if not title:
            continue
        if (task.get("title") or "").strip() in {"", "-"}:
            changes.append(f"{task['id']}: title -> {title[:60]}")
            if not args.check:
                task["title"] = title[:200]
                if not (task.get("goal") or "").strip():
                    task["goal"] = title
                task["updated_at"] = iso(now)
    if not changes:
        print(f"{board['id']}: titles already set")
        return 0
    for change in changes:
        print(("would set " if args.check else "set ") + change)
    if args.check:
        return 1
    store.save()
    store.append_event(event="titles", board=board["id"], count=len(changes), now=args.now)
    print(f"{board['id']}: set {len(changes)} titles")
    return 0


def import_board(args, store: Store, board: dict, registry: dict) -> int:
    """Register existing packet-board work as central tasks (adoption path)."""
    agent = require_agent(args)
    if board["kind"] != "board":
        raise WorkError("only packet boards can be imported; program boards are markdown authority")
    program = args.program
    if not program:
        raise WorkError("--program is required, e.g. --program iam for iam.w07")
    if not re.fullmatch(r"[a-z][a-z0-9.-]{2,63}", program):
        raise WorkError(f"invalid program namespace {program!r}")
    path = Path(board["repo"]).expanduser() / board["path"]
    data = json.loads(path.read_text(encoding="utf-8"))
    packets = data.get("packets", [])
    suffixes = {packet["id"] for packet in packets}
    existing = {task["id"] for task in registry["tasks"]}
    now = parse_now(args.now)
    added = []
    for packet in packets:
        task_id = f"{program}/{packet['id']}"
        if task_id in existing:
            continue
        if packet.get("status") in REVIEW_GATED:
            raise WorkError(f"{task_id}: cannot import into {packet['status']}; use the review pipeline")
        title = packet.get("title") or packet["id"]
        task = {
            "id": task_id,
            "board": board["id"],
            "program": program,
            "owner_repo": board["repo"],
            "title": title,
            "goal": title,
            "kind": packet.get("kind", "implementation"),
            "status": packet.get("status", "draft"),
            "status_source": "board",
            "revision": 0,
            "created_at": iso(now),
            "updated_at": iso(now),
        }
        deps = [f"{program}/{dep}" for dep in packet.get("depends_on", []) if dep in suffixes]
        if deps:
            task["depends_on"] = deps
        paths = packet.get("write_paths", [])
        if paths:
            task["write_paths"] = sorted({normalized_path(p) for p in paths})
        if packet.get("evidence"):
            task["evidence"] = packet["evidence"]
        registry["tasks"].append(task)
        existing.add(task_id)
        added.append(task_id)
    if not added:
        print(f"{board['id']}: nothing to import")
        return 0
    assert_no_cycle(registry)
    store.save()
    store.append_event(event="import", agent=agent, board=board["id"],
                       count=len(added), tasks=added, now=args.now)
    print(f"{board['id']}: imported {len(added)} packets as {program}/…")
    for task_id in added:
        print(f"  {task_id}")
    return 0


def new_packet(suffix: str, task: dict, board: dict) -> dict:
    existing = board.get("packets", [])
    packet_dir = "packets"
    evidence_dir = "evidence"
    if existing and existing[0].get("packet"):
        packet_dir = str(Path(existing[0]["packet"]).parent)
    if existing and existing[0].get("evidence"):
        evidence_dir = str(Path(existing[0]["evidence"]).parent)
    return {
        "id": suffix,
        "title": task.get("title", suffix),
        "kind": task.get("kind", "implementation"),
        "status": task.get("status"),
        "packet": f"{packet_dir}/{suffix}.md",
        "evidence": f"{evidence_dir}/{suffix}.md",
        "depends_on": [dep.split("/", 1)[-1] for dep in task.get("depends_on", [])
                       if dep.startswith(task["id"].split("/", 1)[0] + "/")],
        "dependency_gate": "reviewed",
        "write_paths": list(task.get("write_paths", [])),
        "shared_paths": [],
        "lock_groups": [],
        "execution_lock_groups": [],
        "claim": None,
        "checkpoint": None,
    }


def cmd_reconcile(args, store: Store) -> int:
    registry = store.load()
    board = find_board(registry, args.board)
    if board["kind"] != "board":
        raise WorkError("reconcile operates on packet boards")
    path = Path(board["repo"]).expanduser() / board["path"]
    data = json.loads(path.read_text(encoding="utf-8"))
    statuses = {packet["id"]: packet.get("status") for packet in data.get("packets", [])}
    drift = []
    for task in registry["tasks"]:
        if task["board"] != board["id"]:
            continue
        suffix = task["id"].split("/", 1)[-1]
        board_status = statuses.get(suffix)
        if board_status and board_status != task.get("status"):
            drift.append((task, board_status))
    if not drift:
        print(f"{board['id']}: no status drift")
        return 0
    agent = require_agent(args) if args.apply else None
    now = parse_now(args.now)
    for task, board_status in drift:
        print(f"{task['id']}: registry {task.get('status')} -> board {board_status}")
    if not args.apply:
        print("run with --apply --reason TEXT to adopt board status (boards are authoritative)")
        return 1
    if not args.reason:
        raise WorkError("--apply requires --reason")
    for task, board_status in drift:
        if board_status in REVIEW_GATED:
            raise WorkError(f"{task['id']}: cannot reconcile into {board_status}; use the review pipeline")
    for task, board_status in drift:
        previous = task.get("status")
        task["status"] = board_status
        task["status_source"] = "board"
        task["claim"] = None if board_status not in ACTIVE_STATES else task.get("claim")
        bump(task, board_status, now)
        store.append_event(event="reconcile", task=task["id"], agent=agent, status=board_status,
                           previous_status=previous, revision=task["revision"],
                           reason=args.reason, now=args.now)
    store.save()
    print(f"{board['id']}: adopted {len(drift)} board statuses")
    return 0


def atomic_json_write(path: Path, data: dict) -> None:
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".board.", suffix=".json")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2)
            handle.write("\n")
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


