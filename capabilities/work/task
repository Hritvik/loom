def _esc(value: str) -> str:
    return (str(value).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))


def cmd_graph(args, store: Store) -> int:
    """Render the dependency graph as text, mermaid, dot or a standalone HTML file."""
    registry = store.load()
    tasks = graph_nodes(registry, args.program, args.board, args.open, args.task)
    if not tasks:
        print("no tasks match")
        return 0
    positions, edges = graph_layout(registry, tasks)
    if args.format == "text":
        print(render_graph_text(registry, tasks, positions, edges))
        return 0
    if args.format == "mermaid":
        print(render_graph_mermaid(tasks, edges))
        return 0
    if args.format == "dot":
        print("digraph work {")
        print('  rankdir=LR; node [shape=box, style=rounded, fontsize=10];')
        for task in tasks:
            print(f'  "{task["id"]}" [label="{task["id"]}\\n{task.get("status")}"];')
        for task in tasks:
            for dep in edges.get(task["id"], []):
                print(f'  "{dep}" -> "{task["id"]}";')
        print("}")
        return 0
    out = Path(args.out or "task-graph.html").expanduser()
    out.write_text(render_graph_html(registry, tasks, positions, edges, args.direction),
                   encoding="utf-8")
    print(f"wrote {out}  ({len(tasks)} tasks, {sum(len(v) for v in edges.values())} edges)")
    return 0


def cmd_show(args, store: Store) -> int:
