def parse_duration(value: str) -> dt.timedelta:
    match = DURATION_PATTERN.match(value.strip())
    if not match:
        raise WorkError(f"invalid duration {value!r}; use e.g. 30m, 2h, 7d")
    amount, unit = int(match.group(1)), match.group(2)
    return dt.timedelta(seconds=amount * {"s": 1, "m": 60, "h": 3600, "d": 86400}[unit])


