{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.distracted.dev/iam/events/event-envelope.schema.json",
  "title": "Reusable Identity Platform Event Envelope v1",
  "type": "object", "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producer", "environment", "aggregate", "correlationId", "causationId", "destination", "payload"],
  "properties": {
    "eventId": {"type": "string", "pattern": "^evt_[A-Za-z0-9_-]{16,128}$"},
    "eventType": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"},
    "schemaVersion": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "occurredAt": {"type": "string", "format": "date-time", "maxLength": 35},
    "producer": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "environment": {"enum": ["development", "test", "staging", "production"]},
    "aggregate": {"type": "object", "additionalProperties": false, "required": ["type", "id", "version"], "properties": {
      "type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
      "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,128}$"},
      "version": {"type": "integer", "minimum": 1}
    }},
    "correlationId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "causationId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "maxLength": 128},
    "destination": {"type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 1, "properties": {"appRegistrationId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}}},
    "payload": {"type": "object", "minProperties": 1, "maxProperties": 32}
  }
}
