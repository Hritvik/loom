{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.distracted.dev/iam/events/iam.app-subject.onboarding-ready.v1.payload.schema.json",
  "title": "IAM App Subject Onboarding Ready Payload v1",
  "type": "object", "additionalProperties": false,
  "required": ["appRegistrationId", "appSubject", "activationId", "activationState", "activationVersion", "onboardingReason", "onboardingVersion", "requiredProfileState"],
  "properties": {
    "appRegistrationId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "appSubject": {"type": "string", "pattern": "^aps_[A-Za-z0-9_-]{22,128}$"},
    "activationId": {"type": "string", "pattern": "^act_[A-Za-z0-9_-]{16,128}$"},
    "activationState": {"const": "ACTIVE"},
    "activationVersion": {"type": "integer", "minimum": 1},
    "onboardingReason": {"enum": ["FIRST_ACTIVATION", "RECONCILIATION"]},
    "onboardingVersion": {"type": "integer", "minimum": 1},
    "requiredProfileState": {"const": "PROFILE_REQUIRED"}
  }
}
