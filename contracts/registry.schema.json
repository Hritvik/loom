{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capabilities.local/contracts/registry.schema.json",
  "title": "Wire contract registry",
  "description": "Central index of interaction contracts between portfolio services. The artifact is a copy of the provider's authoritative file; consumers pin a hash of the version they build against.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "updated", "contracts"],
  "properties": {
    "kind": { "const": "wire-contract-registry" },
    "version": { "type": "integer", "minimum": 1 },
    "updated": { "type": "string", "format": "date" },
    "contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/contract" }
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "version", "owner", "status", "consumers", "gate", "source"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9.-]*\\.v[0-9]+$",
          "description": "Namespaced contract id ending in its major version, e.g. ums.profile-status.v1"
        },
        "kind": { "enum": ["http", "event"] },
        "version": { "type": "integer", "minimum": 1 },
        "owner": {
          "type": "string",
          "description": "Program that owns the artifact and may change it",
          "pattern": "^[a-z][a-z0-9-]{1,31}$"
        },
        "status": { "enum": ["proposed", "accepted", "deprecated"] },
        "artifact": {
          "type": ["string", "null"],
          "description": "Path under contracts/ holding the copied artifact; null while proposed"
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash of the artifact file at the recorded source commit"
        },
        "files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Companion files (payload schemas, shared envelopes) copied with the artifact"
        },
        "fixtures": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "valid": { "type": "array", "items": { "type": "string" } },
            "invalid": { "type": "array", "items": { "type": "string" } }
          }
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["service"],
            "properties": {
              "service": { "type": "string", "minLength": 1 },
              "pin": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": ["sha256"],
                "properties": {
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "commit": { "type": "string", "minLength": 4 }
                }
              }
            }
          }
        },
        "gate": {
          "type": "string",
          "description": "Work task that delivers or accepts this contract",
          "pattern": "^[a-z][a-z0-9-]{1,31}/[A-Za-z0-9._-]+$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo", "path", "commit"],
          "properties": {
            "repo": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "commit": { "type": "string", "minLength": 4 }
          }
        },
        "note": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "accepted" } } },
          "then": {
            "required": ["artifact", "sha256"],
            "properties": {
              "artifact": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      ]
    }
  }
}
